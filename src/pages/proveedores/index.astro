<style is:global>
  .agent-card .agent-copy { grid-column: 1; grid-row: 1; min-width: 0; }
  .agent-card .agent-result, .agent-card .agent-progress { grid-column: 2; grid-row: 1; min-width: 0; }
  .agent-progress { align-self: stretch; margin: 0; padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: rgba(0, 0, 0, .13); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04); }
  .progress-head { display: flex; align-items: end; justify-content: space-between; gap: 12px; }
  .progress-label { display: block; color: var(--accent-text); font: 600 10px var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .progress-head strong { display: block; margin-top: 5px; font-size: 13px; }
  .progress-step { color: var(--signal-text); font: 500 11px var(--font-mono); }
  .progress-rail { height: 5px; margin-top: 17px; overflow: hidden; border-radius: 999px; background: var(--surface); }
  .progress-fill { display: block; width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--signal)); background-size: 180% 100%; transform: scaleX(0); transform-origin: left center; transition: transform .55s ease; animation: progress-shimmer 2.2s linear infinite; }
  .progress-strip { display: grid; grid-template-columns: repeat(var(--phase-count, 8), minmax(0, 1fr)); gap: 4px; margin-top: 9px; }
  .progress-segment { height: 4px; border-radius: 99px; background: var(--line); transition: background .35s ease, transform .35s ease; }
  .progress-segment[data-state="done"] { background: var(--ok); }
  .progress-segment[data-state="active"] { background: var(--accent); animation: phase-pulse 1.6s ease-in-out infinite; }
  .progress-segment[data-state="error"] { background: var(--danger); }
  .research-progress { display: grid; gap: 6px; margin-top: 13px; color: var(--text-muted); font: 10px var(--font-mono); }
  .research-progress > div:first-child { display: flex; justify-content: space-between; gap: 10px; }
  .research-progress strong { color: var(--signal-text); font-weight: 600; }
  .research-progress-rail { height: 4px; overflow: hidden; border-radius: 99px; background: var(--surface); }
  .research-progress-rail span { display: block; width: 100%; height: 100%; border-radius: inherit; background: var(--signal); transform: scaleX(0); transform-origin: left center; transition: transform .55s ease; }
  .research-steps { display: grid; gap: 6px; margin: 4px 0 0; padding: 0; list-style: none; }
  .research-steps li { display: flex; align-items: center; gap: 7px; color: var(--text-subtle); font-size: 10px; transition: color .25s ease; }
  .research-steps li > span:first-child { width: 6px; height: 6px; border: 1px solid var(--line-strong); border-radius: 50%; background: transparent; }
  .research-steps li[data-state="active"] { color: var(--text); font-weight: 600; }
