---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getDashboard } from '../../lib/data';
const data = await getDashboard();
---
<AppLayout active="Proveedores" title="Proveedores">
  <div class="page">
    <header class="page-header"><div><p class="eyebrow">Lote y evidencia</p><h1>Proveedores candidatos</h1><p class="page-intro">Revisa primero la evidencia pública. El clic o el formulario no cambian aprobación automáticamente.</p></div><a class="primary-button" href="#importar"><svg viewBox="0 0 20 20"><path d="M10 3v10M6 9l4 4 4-4M4 17h12"/></svg>Importar lote</a></header>
    {!data.connected && <div class="notice"><span class="notice-dot"></span><span><strong>Modo demostración.</strong> Estos registros muestran la interfaz; conecta PostgreSQL para operar datos reales.</span></div>}
    <div class="toolbar"><label class="search"><svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><input id="provider-search" type="search" placeholder="Buscar proveedor, ciudad o categoría" /></label><select class="filter-select" id="status-filter" aria-label="Filtrar por estado"><option value="all">Todos los estados</option><option value="candidate">Candidatos</option><option value="under_review">En revisión</option><option value="approved">Aprobados</option><option value="rejected">Rechazados</option></select></div>
    <section class="panel table-panel" id="importar"><div class="panel-head"><span><strong>Proveedores encontrados</strong> · {data.providers.length} visibles</span><span>Ordenados por última actividad</span></div><div class="table-wrap"><table class="data-table" id="providers-table"><thead><tr><th>Proveedor</th><th>Ciudad / categoría</th><th>Calificación</th><th>Origen</th><th>Estado</th><th></th></tr></thead><tbody>{data.providers.map((provider) => <tr data-search={`${provider.display_name} ${provider.city} ${provider.category}`.toLowerCase()} data-status={provider.status}><td><a class="provider-link" href={`/proveedores/${provider.provider_id}`}>{provider.display_name}</a><div class="muted">ID {provider.provider_id.slice(0, 8)}</div></td><td>{provider.city}<div class="muted">{provider.category}</div></td><td><span class="rating">{provider.rating ?? '—'} <span>★</span></span><div class="muted">{provider.review_count ?? '—'} reseñas</div></td><td class="muted">{provider.discovery_source ?? '—'}</td><td><StatusBadge status={provider.status} /></td><td><a class="text-link" href={`/proveedores/${provider.provider_id}`}>Abrir</a></td></tr>)}</tbody></table></div></section>
    <section class="agent-card" id="agente-gemini"><div class="agent-copy"><div class="agent-kicker"><span class="agent-pulse"></span>Gemini · agente de curaduría</div><h2>Investigar un lote desde la aplicación</h2><p>Gemini busca evidencia pública actual, propone proveedores y devuelve el mismo TSV estricto del panel. Primero muestra una vista previa; importar requiere tu confirmación explícita.</p><form id="gemini-form" class="agent-form"><label>Ciudad<input class="form-input" name="city" required placeholder="Medellín" /></label><label>Categoría<select class="form-input" name="category" required><option value="Música">Música</option><option value="Lugar">Lugar</option><option value="Comida y Bebida">Comida y Bebida</option><option value="Servicios Especializados">Servicios Especializados</option><option value="Entretenimiento">Entretenimiento</option><option value="Decoración temática">Decoración temática</option><option value="Fotografía y Video">Fotografía y Video</option><option value="Invitación digital">Invitación digital</option><option value="Menaje y mantelería">Menaje y mantelería</option><option value="Carpas y mobiliario">Carpas y mobiliario</option></select></label><label>Instrucciones adicionales <span class="muted">opcional</span><textarea class="agent-textarea" name="instructions" placeholder="Ej. prioriza negocios con portafolio para bodas y cobertura en el área metropolitana"></textarea></label><button class="primary-button" type="submit">Investigar con Gemini</button></form><p class="agent-status" id="gemini-status" role="status"></p></div><div class="agent-result" id="gemini-result" hidden><div class="result-head"><strong>Vista previa del lote</strong><span id="gemini-count"></span></div><p id="gemini-summary" class="muted"></p><textarea id="gemini-tsv" aria-label="TSV generado por Gemini"></textarea><div class="result-actions"><button class="primary-button" id="gemini-import" type="button">Confirmar e importar</button><button class="secondary-button" id="gemini-copy" type="button">Copiar TSV</button></div><p class="muted">La validación conserva los rechazos y deja los aceptados como candidatos. No envía correos.</p></div></section>
    <section class="import-card"><div><h2>Importar desde curaduría</h2><p>Pega el bloque TSV de 18 columnas generado por el prompt v2.8. El importador deduplica por fuente y conserva la evidencia original.</p></div><form action="/api/providers/import" method="post"><textarea name="tsv" placeholder="Pega aquí el TSV…" aria-label="Bloque TSV"></textarea><button class="primary-button" type="submit">Validar lote</button></form></section>
  </div>
</AppLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#provider-search');
  const filter = document.querySelector<HTMLSelectElement>('#status-filter');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#providers-table tbody tr')];
  function applyFilters() { const query = search?.value.toLowerCase() ?? ''; const status = filter?.value ?? 'all'; rows.forEach((row) => { const matchText = row.dataset.search?.includes(query); const matchStatus = status === 'all' || row.dataset.status === status; row.hidden = !(matchText && matchStatus); }); }
  search?.addEventListener('input', applyFilters); filter?.addEventListener('change', applyFilters);

  const agentForm = document.querySelector<HTMLFormElement>('#gemini-form');
  const agentResult = document.querySelector<HTMLElement>('#gemini-result');
  const agentStatus = document.querySelector<HTMLElement>('#gemini-status');
  const agentTsv = document.querySelector<HTMLTextAreaElement>('#gemini-tsv');
  const agentCount = document.querySelector<HTMLElement>('#gemini-count');
  const agentSummary = document.querySelector<HTMLElement>('#gemini-summary');
  const importButton = document.querySelector<HTMLButtonElement>('#gemini-import');
  const copyButton = document.querySelector<HTMLButtonElement>('#gemini-copy');
  agentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = new FormData(agentForm);
    if (agentStatus) agentStatus.textContent = 'Investigando fuentes públicas…';
    if (agentResult) agentResult.hidden = true;
    const response = await fetch('/api/ai/curation', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ city: form.get('city'), category: form.get('category'), instructions: form.get('instructions') }) });
    const body = await response.json();
    if (!response.ok || !body.ok) { if (agentStatus) agentStatus.textContent = `No se pudo completar: ${body.error ?? 'error desconocido'}`; return; }
    if (agentTsv) agentTsv.value = body.tsv;
    if (agentCount) agentCount.textContent = `${body.accepted} válidos · ${body.rejected} rechazados`;
    if (agentSummary) agentSummary.textContent = body.researchSummary;
    if (agentResult) agentResult.hidden = false;
    if (agentStatus) agentStatus.textContent = 'Vista previa lista. Revisa las fuentes y confirma solo si el lote es correcto.';
  });
  importButton?.addEventListener('click', async () => {
    if (!agentTsv?.value.trim()) return;
    if (!window.confirm('¿Confirmas importar este lote? Los aceptados quedarán como candidatos y no se enviarán correos.')) return;
    if (agentStatus) agentStatus.textContent = 'Importando lote validado…';
    const response = await fetch('/api/ai/curation', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'import', tsv: agentTsv.value }) });
    const body = await response.json();
    if (agentStatus) agentStatus.textContent = response.ok && body.ok ? `Importación completada: ${body.imported} proveedores.` : `Importación detenida: ${body.error ?? `${body.accepted ?? 0} válidos, ${body.rejected ?? 0} rechazados.`}`;
  });
  copyButton?.addEventListener('click', async () => { if (agentTsv?.value) { await navigator.clipboard.writeText(agentTsv.value); if (agentStatus) agentStatus.textContent = 'TSV copiado al portapapeles.'; } });
</script>
<style>
  .notice { display:flex; align-items:center; gap:9px; margin:-8px 0 21px; padding:11px 14px; border:1px solid var(--warn-line); border-radius:10px; color:var(--warn); background:var(--warn-bg); font-size:12px; }.notice-dot{width:7px;height:7px;border-radius:50%;background:var(--warn)}.agent-card{display:grid;grid-template-columns:1fr 1.15fr;gap:28px;margin-top:24px;padding:22px;border:1px solid var(--accent);border-radius:14px;background:linear-gradient(120deg,var(--accent-soft),var(--surface-2) 58%)}.agent-kicker{display:flex;align-items:center;gap:7px;color:var(--accent-text);font:600 10px var(--font-mono);letter-spacing:.07em;text-transform:uppercase}.agent-pulse{width:7px;height:7px;border-radius:50%;background:var(--signal);box-shadow:0 0 0 4px var(--signal-bg)}.agent-card h2{margin:11px 0 0;font-family:var(--font-display);font-size:17px;font-weight:600}.agent-card p{max-width:520px;color:var(--text-muted);font-size:12px;line-height:1.55}.agent-form{display:grid;gap:10px;margin-top:17px}.agent-form label{display:grid;gap:6px;color:var(--text);font-size:11px;font-weight:600}.agent-textarea{min-height:66px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;resize:vertical;color:var(--text);background:var(--surface);font-size:12px}.agent-form .primary-button{justify-self:start}.agent-status{min-height:18px;margin-bottom:0;color:var(--accent-text)!important}.agent-result{min-width:0;padding:15px;border:1px solid var(--line);border-radius:11px;background:rgba(0,0,0,.12)}.result-head{display:flex;justify-content:space-between;gap:10px;font-size:12px}.result-head span{color:var(--signal-text);font:10px var(--font-mono)}.agent-result textarea{width:100%;min-height:250px;margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:9px;resize:vertical;color:var(--text);background:var(--surface);font:10px/1.45 var(--font-mono)}.result-actions{display:flex;gap:9px;margin-top:10px}.secondary-button{min-height:38px;padding:0 13px;border:1px solid var(--line-strong);border-radius:9px;color:var(--text);background:var(--surface);font-size:12px;font-weight:600}.import-card{display:grid;grid-template-columns:1fr 1.3fr;gap:28px;margin-top:24px;padding:22px;border:1px dashed var(--line-strong);border-radius:14px;background:var(--surface-2)}.import-card h2{margin:0;font-family:var(--font-display);font-size:15px;font-weight:600}.import-card p{max-width:420px;color:var(--text-muted);font-size:12px;line-height:1.55}.import-card form{display:grid;gap:10px}.import-card textarea{min-height:85px;padding:11px;border:1px solid var(--line);border-radius:10px;resize:vertical;color:var(--text);background:var(--surface);font:12px var(--font-mono)}.import-card .primary-button{justify-self:end}@media(max-width:720px){.agent-card,.import-card{grid-template-columns:1fr}.agent-form .primary-button,.import-card .primary-button{justify-self:stretch}.result-actions{flex-direction:column}}
</style>
