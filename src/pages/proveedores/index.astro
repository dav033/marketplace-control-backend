---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getDashboard } from '../../lib/data';
const data = await getDashboard();
---
<AppLayout active="Proveedores" title="Proveedores">
  <div class="page">
    <header class="page-header"><div><p class="eyebrow">Lote y evidencia</p><h1>Proveedores candidatos</h1><p class="page-intro">Revisa primero la evidencia pública. El clic o el formulario no cambian aprobación automáticamente.</p></div><a class="primary-button" href="#importar"><svg viewBox="0 0 20 20"><path d="M10 3v10M6 9l4 4 4-4M4 17h12"/></svg>Importar lote</a></header>
    {!data.connected && <div class="notice"><span class="notice-dot"></span><span><strong>Modo demostración.</strong> Estos registros muestran la interfaz; conecta PostgreSQL para operar datos reales.</span></div>}
    <section class="panel table-panel" id="importar"><div class="panel-head"><span><strong>Proveedores</strong> · <span id="vista-conteo">{data.providers.length}</span> de {data.providers.length}</span><span id="vista-resumen"></span></div><div class="vista-filtros"><label class="vf-busqueda">Buscar<input class="form-input" id="vf-texto" type="search" placeholder="Nombre, ciudad, categoría o teléfono" /></label><label>Agrupar por<select class="form-input" id="vf-grupo"><option value="category">Categoría</option><option value="status">Estado</option><option value="contact_channel">Canal</option><option value="city">Ciudad</option><option value="none">Sin agrupar</option></select></label><label>Estado<select class="form-input" id="vf-estado"><option value="all">Todos</option><option value="candidate">Candidato</option><option value="under_review">En revisión</option><option value="approved">Aprobado</option><option value="rejected">Rechazado</option><option value="archived">Archivado</option></select></label><label>Canal<select class="form-input" id="vf-canal"><option value="all">Todos</option><option value="email">Correo</option><option value="whatsapp">WhatsApp</option></select></label><label>Calificación mín.<input class="form-input" id="vf-rating" type="number" min="0" max="5" step="0.1" placeholder="—" /></label><label>Reseñas mín.<input class="form-input" id="vf-reviews" type="number" min="0" step="1" placeholder="—" /></label><button class="secondary-button" id="vf-limpiar" type="button">Limpiar</button></div><div class="vista-cuerpo" id="vista-cuerpo">{data.providers.map((provider) => (<article class="prov" data-buscar={`${provider.display_name} ${provider.city} ${provider.category} ${provider.phone ?? ''} ${provider.contact_email ?? ''}`.toLowerCase()} data-estado={provider.status} data-canal={provider.contact_channel} data-categoria={provider.category} data-ciudad={provider.city} data-rating={provider.rating ?? ''} data-reviews={provider.review_count ?? ''}><div class="prov-principal"><a class="prov-nombre" href={`/proveedores/${provider.provider_id}`}>{provider.display_name}</a><div class="prov-meta"><span>{provider.category}</span>{provider.additional_categories?.length ? <span class="prov-extra">+{provider.additional_categories.join(", ")}</span> : null}<span>·</span><span>{provider.city}</span></div></div><div class="prov-repu">{provider.rating !== null ? <><span class="prov-estrella">{provider.rating} ★</span><small>{provider.review_count ?? 0} reseñas{provider.platform_count > 1 ? ` · ${provider.platform_count} plataformas` : ""}</small></> : <span class="prov-sin">Sin reputación</span>}</div><div class="prov-contacto"><span class={`channel-badge channel-${provider.contact_channel}`}>{provider.contact_channel === "email" ? "Correo" : "WhatsApp"}</span><small>{provider.contact_channel === "email" ? (provider.contact_email ?? "Sin correo") : (provider.phone ?? "Sin móvil")}</small></div><div class="prov-estado"><StatusBadge status={provider.status} /><small>{provider.last_activity ?? "—"}</small></div></article>))}</div><p class="vista-vacio" id="vista-vacio" hidden>Ningún proveedor coincide con estos filtros.</p></section>
    <section class="agent-card" id="buscar"><div class="agent-copy"><div class="agent-kicker"><span class="agent-pulse"></span>Búsqueda de proveedores</div><h2>Traer proveedores para una categoría</h2><p>Investiga proveedores reales de la categoría en fuentes públicas y trae su contacto. La calificación y las reseñas de cada uno se comprueban contra el registro oficial del negocio, así que ninguna cifra del lote viene estimada. Revisa la vista previa antes de importar.</p><form id="buscar-form" class="agent-form"><label>Ciudad<select class="form-input" name="city" required><option>Bogotá</option><option>Medellín</option><option>Cali</option><option selected>Barranquilla</option><option>Cartagena</option><option>Bucaramanga</option><option>Pereira</option><option>Manizales</option><option>Santa Marta</option><option>Armenia</option><option>Villavicencio</option></select></label><label>Categoría<select class="form-input" name="category" required><option value="">Selecciona una categoría</option><option>Lugar</option><option>Comida y Bebida</option><option>Música</option><option>Servicios Especializados</option><option>Entretenimiento</option><option>Decoración temática</option><option>Fotografía y Video</option><option>Invitación digital</option><option>Menaje y mantelería</option><option>Carpas y mobiliario</option></select></label><div class="buscar-acciones"><button class="primary-button" type="submit">Buscar proveedores</button></div><div class="buscar-umbral"><label>Calificación mínima<input class="form-input" name="minRating" type="number" min="0" max="5" step="0.1" value="4.5" /></label><label>Reseñas mínimas<input class="form-input" name="minReviews" type="number" min="0" max="100000" step="1" value="30" /></label></div><p class="buscar-nota">No se mostrará ningún proveedor por debajo de ese umbral.</p><details class="buscar-avanzado"><summary>Ajustar la búsqueda</summary><label>Cuántos proveedores buscar <span class="muted">1–100</span><input class="form-input" name="targetCount" type="number" min="1" max="100" value="20" /></label><label>Instrucciones adicionales <span class="muted">opcional</span><textarea class="agent-textarea" name="instructions" placeholder="Ej. prioriza negocios con portafolio para bodas"></textarea></label></details></form><p class="agent-status" id="gemini-status" role="status"></p></div><div class="agent-result" id="gemini-result" hidden><div class="result-head"><strong>Proveedores encontrados</strong><span id="gemini-count"></span></div><p id="gemini-summary" class="muted"></p><div class="channel-summary" id="gemini-channels" hidden><p><strong id="gemini-email-count"></strong><span id="gemini-email-names"></span></p><p><strong id="gemini-whatsapp-count"></strong><span id="gemini-whatsapp-names"></span></p></div><textarea id="gemini-tsv" aria-label="Lote de proveedores encontrados"></textarea><div class="result-actions"><button class="primary-button" id="gemini-import" type="button">Confirmar e importar</button><button class="secondary-button" id="gemini-copy" type="button">Copiar el lote</button></div><p class="muted">La validación conserva los rechazos y deja los aceptados como candidatos. No se envían mensajes.</p></div></section>
    <section class="import-card"><div><h2>Importar desde curaduría</h2><p>Pega el bloque TSV de 20 columnas generado por el prompt v2.10. El importador deduplica por fuente y conserva la evidencia original.</p></div><form action="/api/providers/import" method="post"><textarea name="tsv" placeholder="Pega aquí el TSV…" aria-label="Bloque TSV"></textarea><button class="primary-button" type="submit">Validar lote</button></form></section>
  </div>
</AppLayout>
<script>

  const agentLogsEnabled = import.meta.env.DEV;
  const agentLogStorageKey = 'marketplace-control:curation-agent-logs';
  const agentLogLimit = 500;
  let lastAgentLogSignature = '';
  function writeAgentLog(event: string, payload: Record<string, unknown> = {}) {
    if (!agentLogsEnabled) return;
    try {
      const stored = JSON.parse(localStorage.getItem(agentLogStorageKey) ?? '[]');
      const logs = Array.isArray(stored) ? stored : [];
      logs.push({ at: new Date().toISOString(), event, ...payload });
      localStorage.setItem(agentLogStorageKey, JSON.stringify(logs.slice(-agentLogLimit)));
    } catch { /* El diagnóstico no debe romper la curaduría. */ }
  }
  function writeAgentProgressLog(jobId: string, body: { status?: string; phase?: string; phases?: Array<{ key: string; detail: string; state: string; progress?: { current: number; total: number; label?: string } }> }) {
    if (!agentLogsEnabled) return;
    const research = body.phases?.find((phase) => phase.key === 'researching');
    const progress = research?.progress;
    const signature = [jobId, body.status, body.phase, research?.state, research?.detail, progress?.current, progress?.total].join('|');
    if (signature === lastAgentLogSignature) return;
    lastAgentLogSignature = signature;
    writeAgentLog('job.progress', {
      jobId,
      status: body.status,
      phase: body.phase,
      phaseState: research?.state,
      detail: research?.detail,
      progress: progress ? { current: progress.current, total: progress.total, label: progress.label } : undefined,
    });
  }

  // ---- Vista de proveedores: filtros y agrupación ----
  let recargarVista: (() => Promise<void>) | null = null;
  const vistaCuerpo = document.querySelector<HTMLElement>('#vista-cuerpo');
  if (vistaCuerpo) {
    // Referencia no nula para el interior de las funciones: el estrechamiento no cruza el closure.
    const cuerpo = vistaCuerpo;
    const tarjetas = [...cuerpo.querySelectorAll<HTMLElement>('.prov')];
    const vfTexto = document.querySelector<HTMLInputElement>('#vf-texto');
    const vfGrupo = document.querySelector<HTMLSelectElement>('#vf-grupo');
    const vfEstado = document.querySelector<HTMLSelectElement>('#vf-estado');
    const vfCanal = document.querySelector<HTMLSelectElement>('#vf-canal');
    const vfRating = document.querySelector<HTMLInputElement>('#vf-rating');
    const vfReviews = document.querySelector<HTMLInputElement>('#vf-reviews');
    const vistaConteo = document.querySelector<HTMLElement>('#vista-conteo');
    const vistaResumen = document.querySelector<HTMLElement>('#vista-resumen');
    const vistaVacio = document.querySelector<HTMLElement>('#vista-vacio');

    const ETIQUETA_ESTADO: Record<string, string> = {
      candidate: 'Candidato', under_review: 'En revisión', approved: 'Aprobado',
      rejected: 'Rechazado', archived: 'Archivado',
    };
    const ETIQUETA_CANAL: Record<string, string> = { email: 'Correo', whatsapp: 'WhatsApp' };

    function etiquetaGrupo(campo: string, valor: string) {
      if (campo === 'status') return ETIQUETA_ESTADO[valor] ?? valor;
      if (campo === 'contact_channel') return ETIQUETA_CANAL[valor] ?? valor;
      return valor || 'Sin dato';
    }

    function valorDe(tarjeta: HTMLElement, campo: string) {
      if (campo === 'status') return tarjeta.dataset.estado ?? '';
      if (campo === 'contact_channel') return tarjeta.dataset.canal ?? '';
      if (campo === 'city') return tarjeta.dataset.ciudad ?? '';
      return tarjeta.dataset.categoria ?? '';
    }

    function aplicar() {
      const texto = (vfTexto?.value ?? '').trim().toLowerCase();
      const estado = vfEstado?.value ?? 'all';
      const canal = vfCanal?.value ?? 'all';
      const minRating = Number(vfRating?.value);
      const minReviews = Number(vfReviews?.value);

      const visibles = tarjetas.filter((tarjeta) => {
        if (texto && !(tarjeta.dataset.buscar ?? '').includes(texto)) return false;
        if (estado !== 'all' && tarjeta.dataset.estado !== estado) return false;
        if (canal !== 'all' && tarjeta.dataset.canal !== canal) return false;
        if (Number.isFinite(minRating) && vfRating?.value) {
          const rating = Number(tarjeta.dataset.rating);
          if (!Number.isFinite(rating) || rating < minRating) return false;
        }
        if (Number.isFinite(minReviews) && vfReviews?.value) {
          const reviews = Number(tarjeta.dataset.reviews);
          if (!Number.isFinite(reviews) || reviews < minReviews) return false;
        }
        return true;
      });

      const ocultas = new Set(tarjetas.filter((t) => !visibles.includes(t)));
      tarjetas.forEach((tarjeta) => { tarjeta.hidden = ocultas.has(tarjeta); });

      // Las cabeceras de sección se regeneran en cada filtrado: un grupo que se queda sin
      // proveedores visibles no debe dejar su título colgando.
      cuerpo.querySelectorAll('.prov-seccion').forEach((nodo) => nodo.remove());
      const campo = vfGrupo?.value ?? 'category';
      if (campo !== 'none' && visibles.length) {
        const grupos = new Map<string, HTMLElement[]>();
        for (const tarjeta of visibles) {
          const clave = valorDe(tarjeta, campo);
          const lista = grupos.get(clave) ?? [];
          lista.push(tarjeta);
          grupos.set(clave, lista);
        }
        for (const [clave, miembros] of [...grupos].sort((a, b) => b[1].length - a[1].length)) {
          const cabecera = document.createElement('div');
          cabecera.className = 'prov-seccion';
          const conReputacion = miembros.filter((m) => m.dataset.rating);
          const media = conReputacion.length
            ? (conReputacion.reduce((suma, m) => suma + Number(m.dataset.rating), 0) / conReputacion.length).toFixed(1)
            : null;
          cabecera.innerHTML = `<span>${etiquetaGrupo(campo, clave)}</span>`
            + `<span class="prov-seccion-meta">${miembros.length}${media ? ` · media ${media} ★` : ''}</span>`;
          cuerpo.insertBefore(cabecera, miembros[0]);
          for (const miembro of miembros) cuerpo.appendChild(miembro);
        }
      }

      if (vistaConteo) vistaConteo.textContent = String(visibles.length);
      if (vistaVacio) vistaVacio.hidden = visibles.length > 0;
      if (vistaResumen) {
        const correo = visibles.filter((t) => t.dataset.canal === 'email').length;
        vistaResumen.textContent = visibles.length
          ? `${correo} por correo · ${visibles.length - correo} por WhatsApp`
          : '';
      }
    }

    [vfTexto, vfRating, vfReviews].forEach((campo) => campo?.addEventListener('input', aplicar));
    [vfGrupo, vfEstado, vfCanal].forEach((campo) => campo?.addEventListener('change', aplicar));
    document.querySelector('#vf-limpiar')?.addEventListener('click', () => {
      if (vfTexto) vfTexto.value = '';
      if (vfRating) vfRating.value = '';
      if (vfReviews) vfReviews.value = '';
      if (vfEstado) vfEstado.value = 'all';
      if (vfCanal) vfCanal.value = 'all';
      aplicar();
    });

    // Se expone para que la importación pueda refrescar la tabla sin recargar la página ni
    // perder los filtros que el operador tenga puestos.
    recargarVista = async () => {
      const html = await fetch(location.pathname, { cache: 'no-store' }).then((r) => r.text());
      const nuevo = new DOMParser().parseFromString(html, 'text/html').querySelector('#vista-cuerpo');
      if (!nuevo) return;
      cuerpo.innerHTML = nuevo.innerHTML;
      tarjetas.length = 0;
      tarjetas.push(...cuerpo.querySelectorAll<HTMLElement>('.prov'));
      aplicar();
    };

    aplicar();
  }

  const agentForm = document.querySelector<HTMLFormElement>('#buscar-form');
  if (agentForm && !agentForm.querySelector('[name="targetCount"]')) {
    const targetLabel = document.createElement('label');
    targetLabel.append('Objetivo de candidatos relevantes ');
    const targetHint = document.createElement('span');
    targetHint.className = 'muted';
    targetHint.textContent = '1–100 · máximo 20 por escaneo';
    const targetInput = document.createElement('input');
    targetInput.className = 'form-input';
    targetInput.name = 'targetCount';
    targetInput.type = 'number';
    targetInput.min = '1';
    targetInput.max = '100';
    targetInput.value = '20';
    targetInput.required = true;
    targetLabel.append(targetHint, targetInput);
    agentForm.querySelector('select[name="category"]')?.closest('label')?.after(targetLabel);
  }
  const agentResult = document.querySelector<HTMLElement>('#gemini-result');
  const agentGoalStatus = document.createElement('div');
  agentGoalStatus.className = 'goal-status';
  agentGoalStatus.hidden = true;
  agentGoalStatus.setAttribute('role', 'alert');
  agentResult?.querySelector('.result-head')?.after(agentGoalStatus);
  const agentStatus = document.querySelector<HTMLElement>('#gemini-status');
  const agentTsv = document.querySelector<HTMLTextAreaElement>('#gemini-tsv');
  const candidateList = document.createElement('div');
  candidateList.id = 'gemini-candidates';
  candidateList.className = 'candidate-list';
  candidateList.setAttribute('aria-live', 'polite');
  if (agentTsv?.parentElement) {
    const resultContent = agentTsv.parentElement;
    const rawOutput = document.createElement('details');
    rawOutput.className = 'raw-output';
    const rawSummary = document.createElement('summary');
    rawSummary.textContent = 'Ver TSV técnico';
    rawOutput.append(rawSummary);
    resultContent.insertBefore(candidateList, agentTsv);
    resultContent.insertBefore(rawOutput, agentTsv);
    rawOutput.append(agentTsv);
  }
  const agentCount = document.querySelector<HTMLElement>('#gemini-count');
  const agentSummary = document.querySelector<HTMLElement>('#gemini-summary');
  const agentChannels = document.querySelector<HTMLElement>('#gemini-channels');
  const emailCount = document.querySelector<HTMLElement>('#gemini-email-count');
  const emailNames = document.querySelector<HTMLElement>('#gemini-email-names');
  const whatsappCount = document.querySelector<HTMLElement>('#gemini-whatsapp-count');
  const whatsappNames = document.querySelector<HTMLElement>('#gemini-whatsapp-names');
  const importButton = document.querySelector<HTMLButtonElement>('#gemini-import');
  const copyButton = document.querySelector<HTMLButtonElement>('#gemini-copy');
  const submitButton = agentForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const progressPanel = document.createElement('div');
  progressPanel.id = 'gemini-progress';
  progressPanel.className = 'agent-progress';
  progressPanel.hidden = true;
  progressPanel.innerHTML = '<div class="progress-head"><div><span class="progress-label">Actividad del agente</span><strong id="gemini-progress-title">Buscando candidatos</strong></div><span id="gemini-progress-step" class="progress-step">0/4</span></div><div class="progress-rail" role="progressbar" aria-label="Progreso de la investigación" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="gemini-progress-fill" class="progress-fill"></span></div><div id="gemini-progress-strip" class="progress-strip" aria-hidden="true"></div><div id="gemini-research-progress" class="research-progress"><div><span id="gemini-research-label">Buscando candidatos</span><strong id="gemini-research-step">0/4</strong></div><div class="research-progress-rail"><span id="gemini-research-fill"></span></div><ol id="gemini-research-steps" class="research-steps" aria-label="Subfases de investigación"></ol></div><div class="progress-meta"><span><small>Etapa</small><strong id="gemini-progress-state">Investigando</strong></span><span><small>Señal</small><strong>Gemini activo</strong></span></div><p id="gemini-progress-detail" class="muted" aria-live="polite"></p>';
  const agentCard = document.querySelector<HTMLElement>('.agent-card');
  if (agentCard) agentCard.append(progressPanel);
  else agentForm?.after(progressPanel);
  progressPanel.insertAdjacentHTML('beforeend', '<div class="agent-timers" aria-live="polite"><span><small>Tiempo total</small><strong id="gemini-total-timer">00:00</strong></span><span><small>Escaneo actual</small><strong id="gemini-scan-timer">00:00</strong></span></div>');
  const liveCandidateList = document.createElement('div');
  liveCandidateList.id = 'gemini-live-candidates';
  liveCandidateList.className = 'candidate-list live-candidates';
  liveCandidateList.setAttribute('aria-live', 'polite');
  progressPanel.append(liveCandidateList);
  const progressTitle = progressPanel.querySelector<HTMLElement>('#gemini-progress-title');
  const progressStep = progressPanel.querySelector<HTMLElement>('#gemini-progress-step');
  const progressState = progressPanel.querySelector<HTMLElement>('#gemini-progress-state');
  const progressFill = progressPanel.querySelector<HTMLElement>('#gemini-progress-fill');
  const progressRail = progressPanel.querySelector<HTMLElement>('.progress-rail');
  const progressStrip = progressPanel.querySelector<HTMLElement>('#gemini-progress-strip');
  const researchProgress = progressPanel.querySelector<HTMLElement>('#gemini-research-progress');
  const researchLabel = progressPanel.querySelector<HTMLElement>('#gemini-research-label');
  const researchStep = progressPanel.querySelector<HTMLElement>('#gemini-research-step');
  const researchFill = progressPanel.querySelector<HTMLElement>('#gemini-research-fill');
  const researchSteps = progressPanel.querySelector<HTMLOListElement>('#gemini-research-steps');
  const progressDetail = progressPanel.querySelector<HTMLElement>('#gemini-progress-detail');
  const totalTimer = progressPanel.querySelector<HTMLElement>('#gemini-total-timer');
  const scanTimer = progressPanel.querySelector<HTMLElement>('#gemini-scan-timer');
  let timerSnapshot = { totalMs: 0, scanMs: 0, scanNumber: 0, running: false, receivedAt: Date.now() };
  function formatElapsed(milliseconds: number) {
    const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    return hours ? `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}` : `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  }
  function renderTimers() {
    const extra = timerSnapshot.running ? Date.now() - timerSnapshot.receivedAt : 0;
    if (totalTimer) totalTimer.textContent = formatElapsed(timerSnapshot.totalMs + extra);
    if (scanTimer) scanTimer.textContent = `${formatElapsed(timerSnapshot.scanMs + extra)} · escaneo ${timerSnapshot.scanNumber || '—'}`;
  }
  window.setInterval(renderTimers, 250);
  function renderProgress(phases: Array<{ key: string; label: string; state: string; detail: string; progress?: { current: number; total: number; label?: string } }>, timers?: { totalMs?: number; scanMs?: number; scanNumber?: number; running?: boolean }, preview?: { tsv?: string; rejectedRows?: Array<{ line: number; issues?: Array<{ message: string }> }> }) {
    if (timers) timerSnapshot = { totalMs: timers.totalMs ?? 0, scanMs: timers.scanMs ?? 0, scanNumber: timers.scanNumber ?? 0, running: timers.running ?? false, receivedAt: Date.now() };
    renderTimers();
    if (preview?.tsv) renderCandidates(preview.tsv, preview.rejectedRows ?? [], liveCandidateList);
    const research = phases.find((phase) => phase.key === 'researching');
    const ready = phases.find((phase) => phase.key === 'ready');
    const errorPhase = phases.find((phase) => phase.state === 'error');
    const researchData = research?.progress ?? { current: 0, total: 4, label: 'Buscando candidatos' };
    const total = Math.max(researchData.total, 1);
    const currentProgress = ready?.state === 'done' ? total : Math.min(Math.max(researchData.current, 0), total);
    const progressPercent = Math.round((currentProgress / total) * 100);
    const isError = Boolean(errorPhase);
    const isReady = ready?.state === 'done';
    const liveDetail = research?.detail && research.detail !== 'Pendiente' ? research.detail : 'Conectando con Gemini, Google Search y contexto de URLs.';
    if (progressTitle) progressTitle.textContent = isReady ? 'Vista previa lista' : isError ? 'La búsqueda se detuvo' : liveDetail;
    if (progressStep) progressStep.textContent = `${currentProgress}/${total}`;
    if (progressState) progressState.textContent = isError ? 'Requiere atención' : isReady ? 'Listo para revisar' : 'Investigando';
    if (progressFill) progressFill.style.transform = `scaleX(${progressPercent / 100})`;
    if (progressRail) {
      progressRail.setAttribute('aria-valuemax', '100');
      progressRail.setAttribute('aria-valuenow', String(progressPercent));
    }
    if (progressStrip) {
      const labels = ['Buscando candidatos', 'Evaluando reseñas', 'Extrayendo contacto', 'Validando candidatos'];
      progressStrip.style.setProperty('--phase-count', String(labels.length));
      progressStrip.replaceChildren(...labels.map((_, index) => {
        const segment = document.createElement('span');
        segment.className = 'progress-segment';
        segment.dataset.state = currentProgress >= total || index < currentProgress - 1 ? 'done' : index === Math.max(currentProgress - 1, 0) && !isReady ? 'active' : 'pending';
        return segment;
      }));
    }
    if (researchProgress) researchProgress.hidden = isReady || isError;
    if (!isReady && !isError) {
      if (researchLabel) researchLabel.textContent = researchData.label ?? 'Buscando candidatos';
      if (researchStep) researchStep.textContent = `${currentProgress}/${total}`;
      if (researchFill) researchFill.style.transform = `scaleX(${progressPercent / 100})`;
      if (researchSteps) {
        const labels = ['Buscando candidatos', 'Evaluando reseñas y evidencia', 'Extrayendo contacto', 'Validando candidatos'];
        researchSteps.replaceChildren(...labels.map((label, index) => {
          const item = document.createElement('li');
          item.dataset.state = currentProgress > index + 1 ? 'done' : currentProgress === index + 1 || (currentProgress === 0 && index === 0) ? 'active' : 'pending';
          const mark = document.createElement('span');
          mark.setAttribute('aria-hidden', 'true');
          const text = document.createElement('span');
          text.textContent = label;
          item.append(mark, text);
          return item;
        }));
      }
    }
    if (progressDetail) progressDetail.textContent = isReady ? ready?.detail ?? '' : isError ? errorPhase?.detail ?? '' : liveDetail;
  }
  function appendText(parent: HTMLElement, tag: keyof HTMLElementTagNameMap, className: string, value: string) {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = value || 'Sin dato';
    parent.append(element);
    return element;
  }
  function renderCandidates(tsv: string, rejectedRows: Array<{ line: number; issues?: Array<{ message: string }> }>, target = candidateList) {
    if (!target) return;
    target.replaceChildren();
    const lines = tsv.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n').split('\n').filter(line => line.trim());
    const rejectedByLine = new Map(rejectedRows.map(row => [row.line, row]));
    const rows = lines.slice(1);
    rows.forEach((rawLine, index) => {
      const cells = rawLine.split('\t').map(value => value.trim());
      if (cells.length < 20) return;
      const line = index + 2;
      const rejected = rejectedByLine.get(line);
      const [id, name, category, , city, zone, scale, , rating, reviewCount, platform, level, reason, phone, , email, sourceUrl, verificationDate, multiPlatformRaw, additionalCategoriesRaw] = cells;
      const card = document.createElement('article');
      card.className = 'candidate-card';
      card.dataset.state = rejected ? 'rejected' : 'accepted';
      const top = document.createElement('div');
      top.className = 'candidate-top';
      const identity = document.createElement('div');
      appendText(identity, 'span', 'candidate-state', rejected ? 'Requiere revisión' : 'Candidato listo');
      appendText(identity, 'h3', 'candidate-name', name);
      const additionalCategories = (additionalCategoriesRaw || '').split(';').map(value => value.trim()).filter(value => value && value.toLowerCase() !== 'sin dato');
      appendText(identity, 'p', 'candidate-context', `${category}${additionalCategories.length ? ` +${additionalCategories.join(', ')}` : ''} · ${city}`);
      top.append(identity);
      const ratingBlock = document.createElement('div');
      ratingBlock.className = 'candidate-rating';
      appendText(ratingBlock, 'strong', '', `★ ${rating || 'Sin dato'}`);
      appendText(ratingBlock, 'small', '', `${reviewCount || '0'} reseñas`);
      top.append(ratingBlock);
      card.append(top);

      const otherPlatforms = (multiPlatformRaw || '')
        .split(';')
        .map(entry => entry.trim())
        .filter(entry => entry && entry.toLowerCase() !== 'sin dato')
        .map(entry => {
          const [entryPlatform, entryRating, entryReviews] = entry.split(':').map(part => part?.trim());
          return entryPlatform && entryRating && entryReviews ? { entryPlatform, entryRating, entryReviews } : null;
        })
        .filter((entry): entry is { entryPlatform: string; entryRating: string; entryReviews: string } => Boolean(entry))
        .filter(entry => entry.entryPlatform.toLowerCase() !== (platform || '').toLowerCase());
      if (otherPlatforms.length) {
        const platformsRow = document.createElement('div');
        platformsRow.className = 'candidate-platforms';
        otherPlatforms.forEach(({ entryPlatform, entryRating, entryReviews }) => {
          const badge = document.createElement('span');
          badge.className = 'platform-badge';
          badge.textContent = `${entryPlatform} ★${entryRating} (${entryReviews})`;
          platformsRow.append(badge);
        });
        card.append(platformsRow);
      }

      const facts = document.createElement('div');
      facts.className = 'candidate-facts';
      const contact = email && email.toLowerCase() !== 'sin dato' ? 'Correo corporativo' : phone && phone.toLowerCase() !== 'sin dato' ? 'WhatsApp' : 'Sin canal';
      [[ 'Contacto', contact ], [ 'Escala', scale ], [ 'Nivel', level ], [ 'Fuente', platform ]].forEach(([label, value]) => {
        const fact = document.createElement('span');
        appendText(fact, 'small', '', label);
        appendText(fact, 'strong', '', value);
        facts.append(fact);
      });
      card.append(facts);
      appendText(card, 'p', 'candidate-reason', reason);
      const contactLine = document.createElement('p');
      contactLine.className = 'candidate-contact';
      contactLine.textContent = `${email && email.toLowerCase() !== 'sin dato' ? email : phone || 'Sin contacto público'} · ${zone || 'Zona sin clasificar'}`;
      card.append(contactLine);
      if (rejected?.issues?.length) {
        const issues = document.createElement('ul');
        issues.className = 'candidate-issues';
        rejected.issues.forEach(item => appendText(issues, 'li', '', item.message));
        card.append(issues);
      }
      const footer = document.createElement('div');
      footer.className = 'candidate-footer';
      appendText(footer, 'small', '', `${id} · Verificado ${verificationDate || 'sin fecha'}`);
      try {
        const url = new URL(sourceUrl);
        if (['http:', 'https:'].includes(url.protocol)) {
          const link = document.createElement('a');
          link.className = 'text-link';
          link.href = url.href;
          link.target = '_blank';
          link.rel = 'noreferrer';
          link.textContent = 'Abrir evidencia';
          footer.append(link);
        }
      } catch { /* La validación del servidor conserva el rechazo. */ }
      card.append(footer);
      target.append(card);
    });
  }
  async function waitForCuration(jobId: string, maxAttempts = 360) {
    for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
      const response = await fetch(`/api/ai/curation?job_id=${encodeURIComponent(jobId)}`, { cache: 'no-store' });
      const body = await response.json();
      if (!response.ok || !body.ok) {
        writeAgentLog('job.poll_failed', { jobId, httpStatus: response.status, error: body.error });
        throw new Error(body.error ?? 'No se pudo consultar el progreso.');
      }
      renderProgress(body.phases ?? [], body.timers, body.preview);
      writeAgentProgressLog(jobId, body);
      if (body.status === 'completed') return body;
      if (body.status === 'failed') {
        writeAgentLog('job.server_failed', { jobId, error: body.error });
        // Los proveedores parciales siguen en pantalla: el error se anuncia sin borrar el avance.
        const failure = new Error(body.error ?? 'La búsqueda no pudo completarse.');
        (failure as Error & { preview?: unknown }).preview = body.preview;
        throw failure;
      }
      await new Promise((resolve) => setTimeout(resolve, 800));
    }
    writeAgentLog('job.client_timeout', { jobId });
    throw new Error('La búsqueda tardó demasiado. Revisa localStorage antes de reintentar.');
  }
  agentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    event.stopImmediatePropagation();
    if (!agentForm) return;
    const form = new FormData(agentForm);
    let activeJobId = '';
    if (submitButton) submitButton.disabled = true;
    if (agentResult) agentResult.hidden = true;
    liveCandidateList.replaceChildren();
    progressPanel.hidden = false;
    if (agentStatus) agentStatus.textContent = 'Buscando candidatos y preparando evidencia…';
    try {
      const response = await fetch('/api/ai/curation', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ city: form.get('city'), category: form.get('category'), instructions: form.get('instructions'), targetCount: Number(form.get('targetCount') ?? 20), minRating: Number(form.get('minRating') ?? 4.5), minReviews: Number(form.get('minReviews') ?? 30) }) });
      const started = await response.json();
      if (!response.ok || !started.ok || !started.jobId) throw new Error(started.error ?? 'No se pudo iniciar la búsqueda.');
      activeJobId = started.jobId;
      const targetCount = Number(form.get('targetCount') ?? 20);
      writeAgentLog('job.started', { jobId: started.jobId, city: form.get('city'), category: form.get('category'), targetCount });
      writeAgentProgressLog(started.jobId, started);
      renderProgress(started.phases ?? [], started.timers, started.preview);
      const broadRun = form.get('city') === 'Barranquilla' && form.get('category') === 'Comida y Bebida';
      const body = await waitForCuration(started.jobId, broadRun ? 9000 : Math.max(360, Math.min(7200, targetCount * 360)));
      if (agentTsv) agentTsv.value = body.tsv;
      renderCandidates(body.tsv, body.rejectedRows ?? []);
      liveCandidateList.replaceChildren();
      if (agentGoalStatus) {
        agentGoalStatus.hidden = false;
        agentGoalStatus.dataset.state = body.targetReached ? 'success' : 'warning';
        const timing = body.timers ? ` Tiempo total ${formatElapsed(body.timers.totalMs ?? 0)} · último escaneo ${formatElapsed(body.timers.scanMs ?? 0)}.` : '';
        agentGoalStatus.textContent = body.targetReached
          ? `Objetivo alcanzado: ${body.relevantCount ?? body.discovered} candidatos relevantes y ${body.contactable ?? 0} contactables en ${body.attempts ?? 1} escaneo(s).${timing}`
          : `${body.alert ?? `Objetivo incompleto: ${body.relevantCount ?? body.discovered} de ${body.targetCount ?? 20}.`}${timing}`;
        if (!body.targetReached && body.alert) window.alert(body.alert);
      }
      if (agentCount) agentCount.textContent = `${body.discovered ?? body.accepted} encontrados · ${body.contactable ?? 0} contactables · ${body.accepted} listos`;
      if (agentSummary) agentSummary.textContent = `${body.researchSummary}${body.historySaved === false ? ' Historial no guardado.' : ' Historial guardado para evitar repeticiones.'}`;
      const channels = body.contactSummary ?? { email: 0, whatsapp: 0, emailProviders: [], whatsappProviders: [] };
      if (emailCount) emailCount.textContent = `Correo corporativo (${channels.email})`;
      if (emailNames) emailNames.textContent = ` ${channels.emailProviders?.join(', ') || 'ninguna'}`;
      if (whatsappCount) whatsappCount.textContent = `WhatsApp (${channels.whatsapp})`;
      if (whatsappNames) whatsappNames.textContent = ` ${channels.whatsappProviders?.join(', ') || 'ninguna'}`;
      if (agentChannels) agentChannels.hidden = false;
      progressPanel.hidden = true;
      if (agentResult) agentResult.hidden = false;
      if (agentStatus) agentStatus.textContent = 'Vista previa lista. Revisa las fuentes y confirma solo si el lote es correcto.';
      writeAgentLog('job.completed', { jobId: started.jobId, model: body.model, accepted: body.accepted, rejected: body.rejected, discovered: body.discovered, contactable: body.contactable, targetCount: body.targetCount, relevantCount: body.relevantCount, attempts: body.attempts, targetReached: body.targetReached, stoppedReason: body.stoppedReason, historySaved: body.historySaved, contactSummary: body.contactSummary });
    } catch (error) {
      const preview = (error as Error & { preview?: { tsv?: string; rejectedRows?: Array<{ line: number; issues?: Array<{ message: string }> }> } }).preview;
      const partialNote = preview?.tsv
        ? ` Se conservan los ${Math.max(0, preview.tsv.split('\n').length - 1)} proveedores encontrados antes del error; revísalos abajo.`
        : '';
      const errorMessage = `No se pudo completar: ${error instanceof Error ? error.message : 'error desconocido'}${partialNote}`;
      if (preview?.tsv) {
        if (agentTsv) agentTsv.value = preview.tsv;
        renderCandidates(preview.tsv, preview.rejectedRows ?? []);
        liveCandidateList.replaceChildren();
        progressPanel.hidden = true;
        if (agentResult) agentResult.hidden = false;
      }
      if (agentStatus) agentStatus.textContent = errorMessage;
      if (progressDetail) progressDetail.textContent = errorMessage;
      writeAgentLog('job.failed', { jobId: activeJobId || undefined, message: errorMessage });
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
  importButton?.addEventListener('click', async () => {
    if (!agentTsv?.value.trim()) return;
    if (!window.confirm('¿Confirmas importar este lote? Los aceptados quedarán como candidatos y no se enviarán correos.')) return;
    const etiquetaOriginal = importButton.textContent;
    importButton.disabled = true;
    importButton.textContent = 'Guardando…';
    if (copyButton) copyButton.disabled = true;
    if (agentStatus) agentStatus.textContent = 'Guardando los proveedores en la base de datos…';
    const response = await fetch('/api/ai/curation', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'import', tsv: agentTsv.value }) });
    let body: Record<string, unknown> = {};
    try { body = await response.json(); } catch { body = {}; }

    if (response.ok && body.ok) {
      const importados = Number(body.imported ?? 0);
      const rechazados = Number(body.rejected ?? 0);
      // El lote ya está guardado: dejarlo en pantalla invita a importarlo dos veces.
      if (agentTsv) agentTsv.value = '';
      const resultado = document.querySelector<HTMLElement>('#gemini-result');
      if (resultado) resultado.hidden = true;
      if (agentStatus) {
        agentStatus.textContent = `Guardados ${importados} proveedor${importados === 1 ? '' : 'es'}.`
          + (rechazados ? ` ${rechazados} quedaron fuera por no pasar la validación.` : '')
          + ' Ya aparecen en la tabla de arriba.';
      }
      // La tabla se refresca en el sitio, conservando los filtros puestos.
      await recargarVista?.();
    } else if (agentStatus) {
      agentStatus.textContent = `No se pudo guardar: ${body.error ?? 'revisa el lote'}.`;
    }

    importButton.disabled = false;
    importButton.textContent = etiquetaOriginal;
    if (copyButton) copyButton.disabled = false;
  });
  copyButton?.addEventListener('click', async () => { if (agentTsv?.value) { await navigator.clipboard.writeText(agentTsv.value); if (agentStatus) agentStatus.textContent = 'TSV copiado al portapapeles.'; } });

</script>
