nt-size:12px}.hr-flag{padding:1px 6px;border-radius:999px;color:var(--warn);background:var(--warn-bg);font:9px var(--font-mono);white-space:nowrap}.harvest-visible{margin:9px 0 0!important;font:10px var(--font-mono)}.harvest-list{max-height:330px;overflow-y:auto;margin-top:11px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.harvest-row{display:flex;align-items:flex-start;gap:9px;padding:9px 11px;border-bottom:1px solid var(--line);cursor:pointer}.harvest-row:last-child{border-bottom:0}.harvest-row.meets{background:var(--accent-soft)}.harvest-row input{margin-top:3px;flex:none}.hr-main{display:flex;flex-direction:column;gap:2px;min-width:0;font-size:12px}.hr-top{display:flex;align-items:baseline;gap:5px;min-width:0;flex-wrap:wrap}.hr-top strong{min-width:0;overflow-wrap:anywhere}.hr-top .muted{white-space:nowrap;font-size:10px}.hr-meta{color:var(--text-muted);font:10px var(--font-mono)}.hr-meta a{color:var(--accent-text)}.harvest-warn{margin:10px 0 0!important;font-size:11px}.harvest-card .result-actions{align-items:center}.harvest-card .result-actions .muted{font:10px var(--font-mono)}@media(max-width:720px){.harvest-card{grid-template-columns:1fr}.harvest-card .primary-button{justify-self:stretch}}
