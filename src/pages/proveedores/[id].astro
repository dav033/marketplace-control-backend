---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getProvider } from '../../lib/data';
const id = Astro.params.id ?? '';
const provider = await getProvider(id);
if (!provider) return Astro.redirect('/proveedores');
---
<AppLayout active="Proveedores" title={provider.display_name}>
  <div class="page"><div class="page-header"><div><a class="text-link" href="/proveedores">← Volver a proveedores</a><h1 style="margin-top:14px">{provider.display_name}</h1><p class="page-intro">Ficha de evidencia y seguimiento. Los estados se cambian con una decisión explícita.</p></div><StatusBadge status={provider.status} /></div>
    <div class="detail-grid"><section class="panel detail-panel"><div class="detail-title"><div><p class="eyebrow">Ficha de proveedor</p><h2 style="margin:0;font-size:19px">Evidencia disponible</h2><div class="detail-meta"><span class="meta-chip">{provider.city}</span><span class="meta-chip">{provider.category}</span>{provider.additional_categories?.map((extra) => <span class="meta-chip meta-chip-extra">+ {extra}</span>)}<span class="meta-chip">Canal: {provider.contact_channel === 'email' ? 'Correo corporativo' : 'WhatsApp'}</span><span class="meta-chip">Fuente: {provider.discovery_source ?? 'sin registrar'}</span></div></div></div><div class="field-list"><div class="field"><label>Calificación pública</label><span class="rating">{provider.rating ?? 'Sin dato'} {provider.rating && <span>★</span>}</span></div><div class="field"><label>Reseñas</label><span>{provider.review_count ?? 'Sin dato'}</span></div><div class="field"><label>Contacto</label><span>{provider.contact_email ?? 'Aún no encontrado'}</span></div><div class="field"><label>Última actividad</label><span>{provider.last_activity ?? 'Sin actividad'}</span></div></div></section><section class="panel detail-panel"><div class="section-heading"><h2>Reputación por plataforma</h2></div>{provider.sources.length ? <ul class="platform-list">{provider.sources.map((source) => <li><span class="platform-name">{source.source_name}</span><span class="platform-score">★ {source.observed_rating ?? 'Sin dato'}</span><span class="platform-reviews">{source.observed_reviews ?? 0} reseñas</span>{source.source_url && <a class="text-link" href={source.source_url} target="_blank" rel="noreferrer">Ver fuente</a>}</li>)}</ul> : <p class="muted">Sin reputación registrada por plataforma todavía.</p>}</section><section class="panel detail-panel"><div class="section-heading"><h2>Próximos eventos</h2></div><ul class="timeline"><li><span class="timeline-mark"></span><div><strong>Proveedor extraído</strong><p>Entró al lote desde el prompt de curaduría.</p></div></li><li><span class="timeline-mark" style="background:var(--signal);box-shadow:0 0 0 2px var(--signal)"></span><div><strong>Acción siguiente</strong><p>Encontrar contacto válido o enviar campaña aprobada.</p></div></li><li><span class="timeline-mark" style="background:var(--surface);box-shadow:0 0 0 2px var(--line-strong)"></span><div><strong>Formulario</strong><p>Los datos aparecerán aquí cuando el proveedor complete el enlace.</p></div></li></ul></section></div>
  </div>
</AppLayout>
<style>
  .platform-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .platform-list li { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 12px; }
  .platform-list li:first-child { border-top: 0; }
  .platform-name { font-weight: 700; min-width: 110px; }
  .platform-score { color: var(--signal-text); }
  .platform-reviews { color: var(--text-muted); flex: 1; }
  .meta-chip-extra { opacity: .75; }
</style>
