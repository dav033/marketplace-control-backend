---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getProvider } from '../../lib/data';
const id = Astro.params.id ?? '';
const provider = await getProvider(id);
if (!provider) return Astro.redirect('/proveedores');
---
<AppLayout active="Proveedores" title={provider.display_name}>
  <div class="page"><div class="page-header"><div><a class="text-link" href="/proveedores">← Volver a proveedores</a><h1 style="margin-top:14px">{provider.display_name}</h1><p class="page-intro">Ficha de evidencia y seguimiento. Los estados se cambian con una decisión explícita.</p></div><StatusBadge status={provider.status} /></div>
    <div class="detail-grid"><section class="panel detail-panel"><div class="detail-title"><div><p class="eyebrow">Ficha de proveedor</p><h2 style="margin:0;font-size:19px">Evidencia disponible</h2><div class="detail-meta"><span class="meta-chip">{provider.city}</span><span class="meta-chip">{provider.category}</span><span class="meta-chip">Fuente: {provider.discovery_source ?? 'sin registrar'}</span></div></div></div><div class="field-list"><div class="field"><label>Calificación pública</label><span class="rating">{provider.rating ?? 'Sin dato'} {provider.rating && <span>★</span>}</span></div><div class="field"><label>Reseñas</label><span>{provider.review_count ?? 'Sin dato'}</span></div><div class="field"><label>Contacto</label><span>{provider.contact_email ?? 'Aún no encontrado'}</span></div><div class="field"><label>Última actividad</label><span>{provider.last_activity ?? 'Sin actividad'}</span></div></div></section><section class="panel detail-panel"><div class="section-heading"><h2>Próximos eventos</h2></div><ul class="timeline"><li><span class="timeline-mark"></span><div><strong>Proveedor extraído</strong><p>Entró al lote desde el prompt de curaduría.</p></div></li><li><span class="timeline-mark" style="background:var(--lime);box-shadow:0 0 0 1px #a6bd41"></span><div><strong>Acción siguiente</strong><p>Encontrar contacto válido o enviar campaña aprobada.</p></div></li><li><span class="timeline-mark" style="background:#dce3e0;box-shadow:0 0 0 1px #c2cfcb"></span><div><strong>Formulario</strong><p>Los datos aparecerán aquí cuando el proveedor complete el enlace.</p></div></li></ul></section></div>
  </div>
</AppLayout>
