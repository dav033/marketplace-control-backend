---
import AppLayout from '../../layouts/AppLayout.astro';
import { pool, query } from '../../lib/db';

const campaigns = pool ? (await query(`SELECT c.campaign_id, c.name, c.subject, c.status, c.sender_email, c.created_at, count(cs.send_id)::int AS recipients, count(cs.send_id) FILTER (WHERE cs.status = 'sent')::int AS sent, count(cs.send_id) FILTER (WHERE cs.status = 'failed')::int AS failed FROM marketplace.campaigns c LEFT JOIN marketplace.campaign_sends cs ON cs.campaign_id = c.campaign_id GROUP BY c.campaign_id ORDER BY c.created_at DESC LIMIT 30`)).rows : [];
const contacts = pool ? (await query(`SELECT c.contact_id, c.email, c.full_name, p.display_name FROM marketplace.contacts c LEFT JOIN marketplace.providers p ON p.provider_id = c.provider_id WHERE c.consent_status = 'granted' AND c.suppressed_at IS NULL ORDER BY COALESCE(p.display_name, c.email), c.email LIMIT 100`)).rows : [];
const defaultSender = import.meta.env.SES_FROM_EMAIL ?? process.env.SES_FROM_EMAIL ?? '';
---
<AppLayout active="Campañas" title="Campañas">
  <div class="page">
    <header class="page-header"><div><p class="eyebrow">Contacto medible</p><h1>Campañas</h1><p class="page-intro">Crea un correo, selecciona destinatarios elegibles y envíalo desde SES. Los enlaces incluyen un formulario de registro rastreable.</p></div></header>
    <div class="notice"><span class="notice-dot"></span><span><strong>Protección activa.</strong> Solo aparecen contactos con consentimiento de marketing concedido y sin supresión. Usa <code>{'{{nombre}}'}</code> y <code>{'{{enlace_registro}}'}</code> en el cuerpo.</span></div>
    {!pool && <div class="notice"><span class="notice-dot"></span><span><strong>Modo demostración.</strong> Conecta PostgreSQL y configura SES en el servidor para operar campañas.</span></div>}
    <section class="panel campaign-composer"><div class="section-heading"><h2>Nueva campaña</h2><span>{contacts.length} destinatarios elegibles</span></div><form id="campaign-form"><div class="form-grid"><label>Nombre interno<input class="form-input" name="name" required placeholder="Primer contacto · Proveedores" /></label><label>Remitente<input class="form-input" name="sender_email" type="email" required value={defaultSender} placeholder="remitente@dominio.com" /></label><label class="wide">Asunto<input class="form-input" name="subject" required placeholder="Una oportunidad para trabajar juntos" /></label><label class="wide">Cuerpo<textarea class="form-input body-input" name="body_text" required placeholder="Hola {{nombre}},&#10;&#10;Nos gustaría conocer...&#10;&#10;{{enlace_registro}}"></textarea></label></div><div class="recipients"><div class="recipients-head"><strong>Destinatarios con consentimiento</strong><button type="button" class="text-link" id="select-all">Seleccionar todos</button></div>{contacts.length ? <div class="recipient-list">{contacts.map((contact) => <label class="recipient"><input type="checkbox" name="contact_ids" value={contact.contact_id} /><span><strong>{contact.display_name ?? 'Proveedor sin vincular'}</strong><small>{contact.full_name ? `${contact.full_name} · ` : ''}{contact.email}</small></span></label>)}</div> : <p class="empty-state">Aún no hay contactos elegibles. Un proveedor debe aceptar marketing en el formulario público antes de recibir campañas.</p>}</div><label class="check"><input type="checkbox" name="confirm" value="true" required />Confirmo que revisé el contenido y autorizo este envío.</label><button class="primary-button" type="submit" disabled={!contacts.length}>Enviar campaña <svg viewBox="0 0 20 20"><path d="m18 2-7 16-3-7-6-3 16-6Z"/><path d="m8 11 4-4"/></svg></button><p id="campaign-result" class="result" role="status"></p></form></section>
    <section class="panel table-panel history"><div class="panel-head"><span><strong>Historial</strong> · {campaigns.length}</span><span>Envíos registrados en PostgreSQL</span></div>{campaigns.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th>Campaña</th><th>Remitente</th><th>Estado</th><th>Destinatarios</th><th>Enviados</th><th>Fallidos</th></tr></thead><tbody>{campaigns.map((campaign) => <tr><td><strong>{campaign.name}</strong><div class="muted">{campaign.subject}</div></td><td>{campaign.sender_email}</td><td><span class={`status status-${campaign.status}`}>{campaign.status}</span></td><td>{campaign.recipients}</td><td>{campaign.sent}</td><td>{campaign.failed}</td></tr>)}</tbody></table></div> : <div class="empty-state"><strong>Aún no hay campañas</strong><p>La primera campaña aparecerá aquí después de un envío.</p></div>}</section>
  </div>
</AppLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#campaign-form');
  const result = document.querySelector<HTMLElement>('#campaign-result');
  const selectAll = document.querySelector<HTMLButtonElement>('#select-all');
  selectAll?.addEventListener('click', () => document.querySelectorAll<HTMLInputElement>('input[name="contact_ids"]').forEach((input) => { input.checked = true; }));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (result) result.textContent = 'Enviando...';
    const payload: Record<string, unknown> = Object.fromEntries(new FormData(form));
    payload.contact_ids = [...form.querySelectorAll<HTMLInputElement>('input[name="contact_ids"]:checked')].map((input) => input.value);
    const response = await fetch('/api/campaigns', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
    const data = await response.json().catch(() => ({}));
    if (result) result.textContent = response.ok ? `Envío terminado: ${data.sent} enviados, ${data.failed} fallidos.` : `No se pudo enviar: ${data.error ?? 'error desconocido'}.`;
    if (response.ok) window.setTimeout(() => window.location.reload(), 900);
  });
</script>
<style>
  .notice{display:flex;align-items:center;gap:9px;margin:-8px 0 21px;padding:11px 14px;border:1px solid var(--warn-line);border-radius:10px;color:var(--warn);background:var(--warn-bg);font-size:12px}.notice-dot{width:7px;height:7px;border-radius:50%;background:var(--warn)}code{font-family:var(--font-mono);font-size:11px}.campaign-composer{padding:22px;margin-bottom:22px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form-grid label{display:grid;gap:7px;color:var(--text-muted);font-size:11px;font-weight:600}.form-grid .wide{grid-column:1/-1}.body-input{min-height:180px;padding:12px;resize:vertical}.recipients{margin-top:22px;border-top:1px solid var(--line);padding-top:17px}.recipients-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-size:12px}.recipient-list{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.recipient{display:flex;gap:10px;align-items:flex-start;padding:10px;border:1px solid var(--line);border-radius:9px;background:var(--surface-2);font-size:12px}.recipient input{margin-top:2px}.recipient strong,.recipient small{display:block}.recipient small{margin-top:4px;color:var(--text-subtle);font-size:10px}.check{display:flex;align-items:flex-start;gap:9px;margin:18px 0;color:var(--text-muted);font-size:11px}.check input{margin-top:2px}.result{min-height:18px;margin:11px 0 0;color:var(--text-muted);font-size:11px}.history{overflow:hidden}@media(max-width:720px){.form-grid,.recipient-list{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}}
</style>
