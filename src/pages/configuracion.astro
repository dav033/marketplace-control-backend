---
import AppLayout from '../layouts/AppLayout.astro';
import { getDashboard } from '../lib/data';
const data = await getDashboard();
---
<AppLayout active="" title="Configuración"><div class="page"><header class="page-header"><div><p class="eyebrow">Salud del sistema</p><h1>Configuración</h1><p class="page-intro">Puntos que deben quedar resueltos antes de habilitar campañas reales.</p></div></header><div class="content-grid"><section class="panel detail-panel"><div class="section-heading"><h2>Conexiones</h2></div><ul class="settings-list"><li><span><strong>PostgreSQL</strong><small>Base de datos de operación</small></span><b class="check-state">{data.connected ? 'Conectado' : 'Demo'}</b></li><li><span><strong>SES / SMTP</strong><small>Envío desde servidor, nunca navegador</small></span><b class="pending-state">Pendiente</b></li><li><span><strong>HTTPS</strong><small>Requerido para campañas y formularios</small></span><b class="pending-state">Pendiente</b></li></ul></section><section class="panel detail-panel"><div class="section-heading"><h2>Protecciones</h2></div><ul class="settings-list"><li><span><strong>Consentimiento</strong><small>Privacidad y marketing separados</small></span><b class="check-state">Activo</b></li><li><span><strong>Tracking</strong><small>Tokens opacos y hashes</small></span><b class="check-state">Activo</b></li><li><span><strong>Backups</strong><small>pg_dump programado a S3</small></span><b class="pending-state">Pendiente</b></li></ul></section></div></div></AppLayout>
<style>.settings-list{display:grid;gap:0;margin:0;padding:0;list-style:none}.settings-list li{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 0;border-top:1px solid var(--line)}.settings-list li:first-child{border-top:0}.settings-list strong,.settings-list small{display:block}.settings-list strong{font-size:12px}.settings-list small{margin-top:4px;color:var(--text-subtle);font-size:11px}.settings-list b{padding:5px 9px;border-radius:7px;font-size:10px;white-space:nowrap}.check-state{color:var(--ok);background:var(--ok-bg)}.pending-state{color:var(--warn);background:var(--warn-bg)}</style>
