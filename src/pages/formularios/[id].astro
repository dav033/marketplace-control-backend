---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getDashboard } from '../../lib/data';
const data = await getDashboard();
const item = data.registrations.find((entry) => entry.submission_id === Astro.params.id);
if (!item) return Astro.redirect('/formularios');
---
<AppLayout active="Formularios" title="Revisión de formulario"><div class="page"><div class="page-header"><div><a class="text-link" href="/formularios">← Volver a formularios</a><h1 style="margin-top:14px">Revisión de respuesta</h1><p class="page-intro">Confirma identidad, datos de contacto y consentimiento antes de cambiar el estado.</p></div><StatusBadge status={item.submission_status} /></div><div class="detail-grid"><section class="panel detail-panel"><div class="field-list"><div class="field"><label>Empresa</label><span>{item.company_name ?? 'No informado'}</span></div><div class="field"><label>Nombre</label><span>{item.full_name ?? 'No informado'}</span></div><div class="field"><label>Correo</label><span>{item.email}</span></div><div class="field"><label>Recibido</label><span>{item.created_at}</span></div></div><div style="display:flex;gap:9px;margin-top:28px"><button class="primary-button" type="button" disabled>Marcar aprobado</button><button class="secondary-button" type="button" disabled>Solicitar datos</button></div></section><section class="panel detail-panel"><div class="section-heading"><h2>Checklist</h2></div><ul class="checklist"><li><span>01</span>Consentimiento de privacidad guardado</li><li><span>02</span>Correo responde al proveedor correcto</li><li><span>03</span>Datos públicos siguen verificables</li></ul></section></div></div></AppLayout>
<style>.secondary-button{display:inline-flex;align-items:center;min-height:39px;padding:0 15px;border:1px solid var(--line);border-radius:7px;color:var(--ink);background:#fff;font-size:12px;font-weight:750;opacity:.55;cursor:not-allowed}.checklist{display:grid;gap:16px;margin:0;padding:0;list-style:none;color:var(--ink-soft);font-size:11px;line-height:1.4}.checklist li{display:flex;align-items:center;gap:10px}.checklist span{display:grid;width:24px;height:24px;place-items:center;border-radius:6px;color:var(--blue);background:var(--blue-soft);font-size:9px;font-weight:800}</style>
