---
import AppLayout from '../../layouts/AppLayout.astro';
import { query, pool } from '../../lib/db';
import { hashToken } from '../../lib/tracking';

// Las categorías que puede marcar el proveedor son las mismas 10 de la curaduría: si aquí
// apareciera una etiqueta libre, la ficha resultante no podría cruzarse con el resto del sistema.
const CATEGORIES = [
  'Lugar', 'Comida y Bebida', 'Música', 'Servicios Especializados', 'Entretenimiento',
  'Decoración temática', 'Fotografía y Video', 'Invitación digital', 'Menaje y mantelería', 'Carpas y mobiliario',
];

const token = Astro.params.token ?? '';
const sent = Astro.url.searchParams.get('sent') === '1';

type LinkState = 'valid' | 'expired' | 'submitted' | 'unknown';

let providerName = 'tu negocio de eventos';
let linkState: LinkState = 'valid';
let submittedAt: Date | null = null;

if (pool && token) {
  try {
    const result = await query<{
      display_name: string | null;
      token_expires_at: Date | null;
      form_submitted_at: Date | null;
    }>(
      `SELECT p.display_name, cs.token_expires_at, cs.form_submitted_at
       FROM marketplace.campaign_sends cs
       LEFT JOIN marketplace.providers p ON p.provider_id = cs.provider_id
       WHERE cs.tracking_token_hash = $1
       LIMIT 1`,
      [hashToken(token)],
    );
    const row = result.rows[0];
    if (!row) {
      linkState = 'unknown';
    } else {
      providerName = row.display_name ?? providerName;
      if (row.form_submitted_at) {
        linkState = 'submitted';
        submittedAt = row.form_submitted_at;
      } else if (row.token_expires_at && row.token_expires_at.getTime() < Date.now()) {
        // Un `token_expires_at` nulo es un envío anterior a la migración: se deja pasar.
        linkState = 'expired';
      }
    }
  } catch {
    // El formulario sigue disponible mientras la base se recupera; la validación real la repite el
    // endpoint al recibir el envío, que es donde importa.
  }
}

const dateFormatter = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
const showForm = !sent && linkState === 'valid';
const productsLabelId = 'lbl-productos';
---
<AppLayout title="Registro de proveedor" publicView>
  <main class="public-card registro">
    <a class="brand" href="/" aria-label="Marketplace Control">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span><strong style="color:var(--text)">marketplace</strong><small style="color:var(--text-subtle)">control room</small></span>
    </a>

    {sent && (
      <>
        <p class="eyebrow" style="margin-top:34px">Perfil de proveedor</p>
        <h1>Datos recibidos</h1>
        <p>Gracias. Tu información queda en nuestra bandeja de revisión. Si necesitamos algo más te escribimos al mismo correo.</p>
      </>
    )}

    {!sent && linkState === 'submitted' && (
      <>
        <p class="eyebrow" style="margin-top:34px">Perfil de proveedor</p>
        <h1>Ya tenemos tu información</h1>
        <p>
          {submittedAt
            ? `La registramos el ${dateFormatter.format(submittedAt)} y la tiene nuestro equipo.`
            : 'Ya registramos tu ficha y la tiene nuestro equipo.'}
          {' '}Este formulario se envía una sola vez: si algo cambió, responde a nuestro correo y lo actualizamos.
        </p>
      </>
    )}

    {!sent && linkState === 'expired' && (
      <>
        <p class="eyebrow" style="margin-top:34px">Enlace vencido</p>
        <h1>Este enlace ya caducó</h1>
        <p>Por seguridad los enlaces de registro tienen fecha de vencimiento. Responde a nuestro correo y te enviamos uno nuevo para completar tu ficha.</p>
      </>
    )}

    {!sent && linkState === 'unknown' && (
      <>
        <p class="eyebrow" style="margin-top:34px">Enlace no reconocido</p>
        <h1>No encontramos este enlace</h1>
        <p>Puede que se haya copiado incompleto. Abre el enlace directamente desde el correo que te enviamos, o respóndenos y te ayudamos.</p>
      </>
    )}

    {showForm && (
      <>
        <p class="eyebrow" style="margin-top:34px">Perfil de proveedor</p>
        <h1>Cuéntanos sobre {providerName}</h1>
        <p>Con esto sabemos a qué eventos recomendarte. Toma dos minutos y se envía una sola vez.</p>

        <form class="public-form registro-form" method="post" action="/api/public/form-submit" id="registro-form">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="products" id="products-field" value="" />
          <input type="hidden" name="services" id="services-field" value="" />

          <label>Nombre de contacto<input class="form-input" name="full_name" required autocomplete="name" /></label>
          <label>Nombre de tu local o marca<input class="form-input" name="company_name" value={providerName} required autocomplete="organization" /></label>
          <label>Correo de contacto<input class="form-input" type="email" name="email" required autocomplete="email" /></label>
          <label>Teléfono <span class="opcional">opcional</span><input class="form-input" name="phone" autocomplete="tel" /></label>

          <div class="campo">
            <div class="campo-head">
              <span class="campo-label" id={productsLabelId}>¿Qué ofreces?</span>
              <span class="campo-count" id="products-count">0 / 10</span>
            </div>
            <p class="campo-help">Escribe cada producto o paquete como lo llamas tú.</p>
            <div class="campo-add">
              <input class="form-input" id="products-input" type="text" maxlength="60" placeholder="Ej. cobertura de boda completa" aria-labelledby={productsLabelId} />
              <button class="secondary-button" id="products-add" type="button">Añadir</button>
            </div>
            <ul class="fichas" id="products-list" aria-labelledby={productsLabelId}></ul>
          </div>

          <div class="campo">
            <div class="campo-head">
              <span class="campo-label">¿En qué categorías trabajas?</span>
              <span class="campo-count" id="services-count">0 / 5</span>
            </div>
            <p class="campo-help">Elige hasta cinco. Son las que usamos para buscarte.</p>
            <div class="opciones" role="group" aria-label="Categorías">
              {CATEGORIES.map((category) => (
                <button class="opcion" type="button" data-categoria={category} aria-pressed="false">{category}</button>
              ))}
            </div>
          </div>

          <div class="campo">
            <div class="campo-head"><span class="campo-label">¿Para cuánta gente?</span></div>
            <p class="campo-help">El tamaño de evento que puedes atender con comodidad.</p>
            <div class="volumen">
              <div class="volumen-row">
                <input class="form-input" id="volume-min" name="volume_min" type="number" min="1" max="100000" value="20" required aria-label="Mínimo de asistentes" />
                <span>a</span>
                <input class="form-input" id="volume-max" name="volume_max" type="number" min="1" max="100000" value="180" required aria-label="Máximo de asistentes" />
                <span>personas</span>
              </div>
              <div class="volumen-barra" aria-hidden="true"><i id="volume-fill"></i></div>
              <div class="volumen-escala" aria-hidden="true"><span>1</span><span>50</span><span>200</span><span>500+</span></div>
              <p class="volumen-resultado" id="volume-result"></p>
            </div>
          </div>

          <label>Algo más que debamos saber <span class="opcional">opcional</span><textarea class="form-input" name="description" rows="3" placeholder="Cobertura, años de experiencia, lo que te diferencia"></textarea></label>

          <label class="check"><input type="checkbox" name="privacy_consent" value="true" required />Acepto que mis datos sean usados para revisar mi perfil como proveedor.</label>
          <label class="check"><input type="checkbox" name="marketing_consent" value="true" />Quiero recibir oportunidades de eventos por correo.</label>

          <p class="form-error" id="form-error" role="alert" hidden></p>
          <button class="primary-button" type="submit" id="registro-submit">Enviar mi información</button>
          <p class="form-nota">Se envía una sola vez · No compartimos tus datos con terceros</p>
        </form>
      </>
    )}
  </main>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#registro-form');
  if (form) {
    const MAX_PRODUCTS = 10;
    const MAX_SERVICES = 5;
    const products: string[] = [];
    const services: string[] = [];

    const productsInput = document.querySelector<HTMLInputElement>('#products-input');
    const productsAdd = document.querySelector<HTMLButtonElement>('#products-add');
    const productsList = document.querySelector<HTMLUListElement>('#products-list');
    const productsCount = document.querySelector<HTMLElement>('#products-count');
    const productsField = document.querySelector<HTMLInputElement>('#products-field');
    const servicesCount = document.querySelector<HTMLElement>('#services-count');
    const servicesField = document.querySelector<HTMLInputElement>('#services-field');
    const volumeMin = document.querySelector<HTMLInputElement>('#volume-min');
    const volumeMax = document.querySelector<HTMLInputElement>('#volume-max');
    const volumeFill = document.querySelector<HTMLElement>('#volume-fill');
    const volumeResult = document.querySelector<HTMLElement>('#volume-result');
    const formError = document.querySelector<HTMLElement>('#form-error');

    function renderProducts() {
      if (!productsList || !productsCount) return;
      productsList.replaceChildren(...products.map((product, index) => {
        const item = document.createElement('li');
        item.className = 'ficha';
        item.append(product);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.setAttribute('aria-label', `Quitar ${product}`);
        remove.textContent = '×';
        remove.addEventListener('click', () => { products.splice(index, 1); renderProducts(); });
        item.append(remove);
        return item;
      }));
      const full = products.length >= MAX_PRODUCTS;
      productsCount.textContent = `${products.length} / ${MAX_PRODUCTS}`;
      productsCount.classList.toggle('lleno', full);
      if (productsAdd) productsAdd.disabled = full;
      if (productsInput) {
        productsInput.disabled = full;
        productsInput.placeholder = full ? 'Llegaste al máximo de diez' : 'Ej. cobertura de boda completa';
      }
      if (productsField) productsField.value = JSON.stringify(products);
    }

    function renderServices() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.opcion');
      const full = services.length >= MAX_SERVICES;
      buttons.forEach((button) => {
        const category = button.dataset.categoria ?? '';
        const active = services.includes(category);
        button.setAttribute('aria-pressed', String(active));
        button.disabled = !active && full;
      });
      if (servicesCount) {
        servicesCount.textContent = `${services.length} / ${MAX_SERVICES}`;
        servicesCount.classList.toggle('lleno', full);
      }
      if (servicesField) servicesField.value = JSON.stringify(services);
    }

    /** Escala logarítmica: en lineal, todo lo pequeño se apelmazaría contra el borde izquierdo. */
    function position(value: number) {
      const bounded = Math.max(1, Math.min(500, value));
      return (Math.log(bounded) / Math.log(500)) * 100;
    }

    function renderVolume() {
      if (!volumeMin || !volumeMax || !volumeFill || !volumeResult) return;
      const min = Number(volumeMin.value) || 0;
      const max = Number(volumeMax.value) || 0;
      const invalid = max < min || min < 1;
      volumeFill.style.left = `${position(min)}%`;
      volumeFill.style.right = `${100 - position(max)}%`;
      volumeResult.textContent = invalid
        ? 'El máximo no puede ser menor que el mínimo.'
        : `Eventos de ${min} a ${max} personas.`;
      volumeResult.classList.toggle('invalido', invalid);
    }

    productsAdd?.addEventListener('click', () => {
      const value = productsInput?.value.trim() ?? '';
      if (!value || products.length >= MAX_PRODUCTS) return;
      if (!products.includes(value)) products.push(value);
      if (productsInput) productsInput.value = '';
      renderProducts();
      if (productsInput && !productsInput.disabled) productsInput.focus();
    });

    productsInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') { event.preventDefault(); productsAdd?.click(); }
    });

    document.querySelectorAll<HTMLButtonElement>('.opcion').forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.categoria ?? '';
        const at = services.indexOf(category);
        if (at !== -1) services.splice(at, 1);
        else if (services.length < MAX_SERVICES) services.push(category);
        renderServices();
      });
    });

    volumeMin?.addEventListener('input', renderVolume);
    volumeMax?.addEventListener('input', renderVolume);

    form.addEventListener('submit', (event) => {
      const min = Number(volumeMin?.value);
      const max = Number(volumeMax?.value);
      let problem = '';
      if (!products.length) problem = 'Añade al menos un producto que ofrezcas.';
      else if (!services.length) problem = 'Marca al menos una categoría en la que trabajas.';
      else if (!Number.isFinite(min) || !Number.isFinite(max) || max < min || min < 1) problem = 'Revisa el rango de asistentes: el máximo no puede ser menor que el mínimo.';
      if (problem) {
        event.preventDefault();
        if (formError) { formError.textContent = problem; formError.hidden = false; }
        return;
      }
      if (formError) formError.hidden = true;
    });

    renderProducts();
    renderServices();
    renderVolume();
  }
</script>

<style>
  .registro h1 { text-wrap: balance; }
  .opcional { color: var(--text-subtle); font-weight: 400; }

  .campo { display: grid; gap: 7px; }
  .campo-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px; }
  .campo-label { color: var(--text); font-size: 13px; font-weight: 600; }
  .campo-count { color: var(--text-subtle); font: 11px var(--font-mono); font-variant-numeric: tabular-nums; }
  .campo-count.lleno { color: var(--signal-text); }
  .campo-help { margin: 0; color: var(--text-muted); font-size: 12px; line-height: 1.45; }

  .campo-add { display: flex; gap: 8px; }
  .campo-add .form-input { flex: 1; min-width: 0; }
  .campo-add .secondary-button { flex: none; }

  .fichas { display: flex; flex-wrap: wrap; gap: 7px; margin: 3px 0 0; padding: 0; list-style: none; }
  .fichas:empty { display: none; }
  .ficha {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 7px 5px 11px; border: 1px solid var(--accent-soft); border-radius: 999px;
    background: var(--accent-soft); color: var(--accent-text); font-size: 12px;
  }
  .ficha button {
    display: grid; place-items: center; width: 18px; height: 18px; padding: 0;
    border: 0; border-radius: 50%; background: rgba(0, 0, 0, .28);
    color: inherit; font-size: 13px; line-height: 1; cursor: pointer;
  }
  .ficha button:hover { background: rgba(0, 0, 0, .45); }

  .opciones { display: flex; flex-wrap: wrap; gap: 7px; }
  .opcion {
    min-height: 34px; padding: 0 13px; border: 1px solid var(--line-strong); border-radius: 999px;
    background: var(--surface-2); color: var(--text-muted);
    font: inherit; font-size: 12px; cursor: pointer;
  }
  .opcion:hover:not(:disabled):not([aria-pressed='true']) { border-color: var(--text-subtle); color: var(--text); }
  .opcion[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
  .opcion:disabled { opacity: .38; cursor: not-allowed; }

  .volumen { padding: 14px; border: 1px solid var(--line); border-radius: 11px; background: var(--surface-2); }
  .volumen-row { display: flex; align-items: center; gap: 9px; }
  .volumen-row .form-input { width: 100%; text-align: center; font-variant-numeric: tabular-nums; }
  .volumen-row span { flex: none; color: var(--text-subtle); font-size: 12px; }
  .volumen-barra { position: relative; height: 5px; margin: 14px 0 8px; border-radius: 3px; background: var(--rail); overflow: hidden; }
  .volumen-barra i { position: absolute; top: 0; bottom: 0; border-radius: 3px; background: var(--accent); transition: left .18s ease, right .18s ease; }
  .volumen-escala { display: flex; justify-content: space-between; color: var(--text-subtle); font: 10px var(--font-mono); }
  .volumen-resultado { margin: 11px 0 0; color: var(--text-muted); font-size: 12px; }
  .volumen-resultado.invalido { color: var(--danger); }

  .form-error {
    margin: 0; padding: 10px 13px; border: 1px solid var(--line-strong); border-radius: 10px;
    background: var(--danger-bg); color: var(--danger); font-size: 12px;
  }
  .form-nota { margin: -4px 0 0; color: var(--text-subtle); font-size: 11px; text-align: center; }

  @media (max-width: 520px) {
    .campo-add { flex-direction: column; }
    .campo-add .secondary-button { width: 100%; }
  }
</style>
