{
  "mcpServers": {
    "marketplace-control": {
      "command": "ssh",
      "args": [
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "ConnectTimeout=10",
        "-i",
        "C:/Users/YOU/.ssh/marketplace-aws",
        "ec2-user@YOUR_EC2_HOST",
        "sudo",
        "-n",
        "/usr/local/bin/marketplace-control-mcp"
      ]
    }
  }
}
