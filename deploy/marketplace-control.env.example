# Copiar manualmente a /etc/marketplace-control/marketplace-control.env.
# Permisos: root:root 0600. Nunca commitear valores reales.
NODE_ENV=production
HOST=127.0.0.1
PORT=4321
DATABASE_URL=postgresql://usuario:contraseña@127.0.0.1:5432/marketplace
ADMIN_ACCESS_KEY=cambiar-por-una-clave-larga-y-aleatoria
REGISTRATION_TOKEN_TTL_DAYS=30
# Compartido con el frontend en Vercel (mismo valor en su BACKEND_SERVICE_TOKEN).
BACKEND_SERVICE_TOKEN=
# URL del panel en Vercel; sin ella /t/:token no sabe a dónde redirigir.
FRONTEND_URL=
GEMINI_AGENT_MODEL=gemini-3.8-flash
CURATION_PROVIDER=gemini
GEMINI_API_KEY=
# Agente de conversación por WhatsApp (usa GEMINI_API_KEY).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Simulación desde el panel con "id: <proveedor>". Vacío = cualquier número; lista = solo esos; "off" = nadie.
WHATSAPP_SIMULATION_NUMBERS=
# Modo prueba: con un número aquí, TODO WhatsApp que sale (invitaciones y respuestas del agente) va a
# ese número y no al proveedor real. Quitarlo antes de escribir a proveedores de verdad.
WHATSAPP_REDIRECT_ALL_TO=
# --- Google Places (apagado por defecto) ---
# Los campos que pide el código facturan como SKU "Text Search Enterprise": 1.000 peticiones gratis
# al mes y ~USD 35 por cada 1.000 más. La clave sola NO activa nada.
GOOGLE_PLACES_API_KEY=
# Opt-in explícito. Sin "1" no sale ninguna petición aunque haya clave.
GOOGLE_PLACES_OPT_IN=
# Interruptor de emergencia: con "1" apaga Places aunque haya opt-in.
GOOGLE_PLACES_KILL_SWITCH=
# Tope duro de peticiones por proceso y día UTC (vacío = 50). Un valor ilegible cierra la puerta.
GOOGLE_PLACES_MAX_REQUESTS=
# Reputación de las filas en "Sin dato": ficha de Google Maps vía Serper (/maps, 3 créditos por consulta).
# Sin clave, la buscan subagentes de Gemini (más lentos e intermitentes). CURATION_SKIP_REPUTATION_SUBAGENTS=1 apaga el paso.
SERPER_API_KEY=
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=sonnet
OMNISEND_API_KEY=
OMNISEND_VERSION=2026-03-15
OMNISEND_SENDER_NAME=Happia
OMNISEND_SENDER_EMAIL=info@happia.co
OMNISEND_REPLY_TO_EMAIL=
QA_TEST_RECIPIENT=david.theran03@gmail.com
QA_TEST_RECIPIENTS=davidt@sempertex.com,andresp@sempertex.com,david.theran03@sempertex.com
