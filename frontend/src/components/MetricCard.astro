---
const { label, value, note, kind = 'grid' } = Astro.props;
---
<article class="metric">
  <div class="metric-top"><span>{label}</span><span class="metric-mark" aria-hidden="true">
    {kind === 'pin' && <svg viewBox="0 0 20 20"><path d="M10 18s6-5.2 6-10A6 6 0 0 0 4 8c0 4.8 6 10 6 10Z"/><circle cx="10" cy="8" r="2"/></svg>}
    {kind === 'send' && <svg viewBox="0 0 20 20"><path d="m18 2-7 16-3-7-6-3 16-6Z"/><path d="m8 11 4-4"/></svg>}
    {kind === 'inbox' && <svg viewBox="0 0 20 20"><path d="M3 4h14v12H3z"/><path d="M3 12h4l1 2h4l1-2h4"/></svg>}
    {kind === 'spark' && <svg viewBox="0 0 20 20"><path d="m10 2 1.6 5.4L17 9l-5.4 1.6L10 16l-1.6-5.4L3 9l5.4-1.6L10 2Z"/></svg>}
  </span></div>
  <strong class="metric-number">{value}</strong><span class="metric-foot">{note}</span>
</article>
