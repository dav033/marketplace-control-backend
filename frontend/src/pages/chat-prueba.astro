---
import AppLayout from '../layouts/AppLayout.astro';

// Prueba local del bot de WhatsApp sin pasar por Meta. La conversación que se ve aquí es la misma
// que tendría un proveedor por WhatsApp: mismo motor, mismas preguntas, mismo guardado.
const disponible = import.meta.env.DEV;
---
<AppLayout active="Chat de prueba" title="Chat de prueba">
  <div class="page">
    <header class="page-header">
      <div>
        <p class="eyebrow">Pruebas</p>
        <h1>Chat de prueba del bot</h1>
        <p class="page-intro">La misma conversación que tendrá un proveedor por WhatsApp, sin depender de Meta. Rellena el formulario de registro hablando.</p>
      </div>
      <button class="secondary-button" id="reiniciar" type="button">Reiniciar</button>
    </header>

    {!disponible && (
      <div class="notice"><span class="notice-dot"></span><span><strong>Solo en desarrollo.</strong> Este chat escribe fichas sin el token del correo, así que no se sirve en producción.</span></div>
    )}

    {disponible && (
      <section class="chat-grid">
        <div class="panel chat-panel">
          <div class="panel-head"><span><strong>Conversación</strong></span><span id="estado-chat" class="muted">Listo</span></div>
          <div class="chat-candidato">
            <label for="candidato">Escribir como si contactáramos a</label>
            <select class="form-input" id="candidato">
              <option value="">Nadie: el proveedor escribe primero</option>
            </select>
          </div>
          <div class="chat-hilo" id="hilo" aria-live="polite"></div>
          <form class="chat-form" id="chat-form">
            <input class="form-input" id="entrada" type="text" placeholder="Escribe como si fueras el proveedor…" autocomplete="off" required />
            <button class="primary-button" type="submit">Enviar</button>
          </form>
        </div>

        <aside class="panel chat-panel">
          <div class="panel-head"><span><strong>Ficha que se va armando</strong></span></div>
          <p class="muted chat-nota">Esto es lo que el bot tiene recogido hasta ahora. Son los mismos campos que pide el formulario del correo.</p>
          <dl class="chat-borrador" id="borrador"></dl>
        </aside>
      </section>
    )}
  </div>
</AppLayout>

<style>
  .chat-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .chat-panel { display: flex; flex-direction: column; min-height: 0; }
  .chat-hilo { display: flex; flex-direction: column; gap: 10px; padding: 18px; min-height: 380px; max-height: 58vh; overflow-y: auto; }
  .chat-burbuja { max-width: 78%; padding: 10px 13px; border-radius: 13px; font-size: 13px; line-height: 1.5; white-space: pre-line; }
  .chat-burbuja.bot { align-self: flex-start; color: var(--text); background: var(--surface-2); border: 1px solid var(--line); }
  .chat-burbuja.persona { align-self: flex-end; color: #04120a; background: var(--accent); }
  .chat-form { display: flex; gap: 9px; padding: 14px 18px; border-top: 1px solid var(--line); }
  .chat-form .form-input { flex: 1; }
  .chat-nota { padding: 0 18px; font-size: 12px; }
  .chat-candidato { display: grid; gap: 6px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .chat-candidato label { color: var(--text-subtle); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .chat-borrador { display: grid; gap: 11px; margin: 0; padding: 16px 18px 20px; }
  .chat-borrador div { display: grid; gap: 3px; }
  .chat-borrador dt { color: var(--text-subtle); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .chat-borrador dd { margin: 0; color: var(--text); font-size: 13px; }
  .chat-borrador .pendiente dd { color: var(--text-subtle); }
  @media (max-width: 900px) { .chat-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const hilo = document.getElementById('hilo');
  const formulario = document.getElementById('chat-form') as HTMLFormElement | null;
  const entrada = document.getElementById('entrada') as HTMLInputElement | null;
  const estado = document.getElementById('estado-chat');
  const borrador = document.getElementById('borrador');
  const reiniciar = document.getElementById('reiniciar');
  const candidato = document.getElementById('candidato') as HTMLSelectElement | null;

  if (hilo && formulario && entrada && estado && borrador && candidato) {
    type Candidato = { providerId: string; displayName: string; city: string | null; category: string | null; additionalCategories: string[]; phone: string | null; email: string | null };
    let candidatos: Candidato[] = [];
    // Una sesión por pestaña: así puedes abrir dos y simular dos proveedores a la vez.
    const sessionId = `prueba-${Math.random().toString(36).slice(2, 10)}`;

    const ETIQUETAS: Array<[string, string]> = [
      ['company_name', 'Empresa'], ['full_name', 'Contacto'], ['email', 'Correo'], ['phone', 'Teléfono'],
      ['services', 'Categorías'], ['products', 'Ofrece'], ['volume_min', 'Asistentes'],
      ['description', 'Nota'], ['privacy_consent', 'Autoriza datos'], ['marketing_consent', 'Novedades'],
    ];

    function burbuja(texto: string, quien: 'bot' | 'persona') {
      const nodo = document.createElement('div');
      nodo.className = `chat-burbuja ${quien}`;
      nodo.textContent = texto;
      hilo!.appendChild(nodo);
      hilo!.scrollTop = hilo!.scrollHeight;
    }

    function pintarBorrador(datos: Record<string, unknown>) {
      borrador!.innerHTML = '';
      for (const [clave, etiqueta] of ETIQUETAS) {
        let valor = datos[clave];
        if (clave === 'volume_min') {
          valor = datos.volume_min !== undefined ? `de ${datos.volume_min} a ${datos.volume_max}` : undefined;
        }
        if (Array.isArray(valor)) valor = valor.join(', ');
        if (typeof valor === 'boolean') valor = valor ? 'sí' : 'no';
        if (valor === null) valor = '—';

        const bloque = document.createElement('div');
        if (valor === undefined) bloque.className = 'pendiente';
        const dt = document.createElement('dt');
        dt.textContent = etiqueta;
        const dd = document.createElement('dd');
        dd.textContent = valor === undefined ? 'Pendiente' : String(valor);
        bloque.append(dt, dd);
        borrador!.appendChild(bloque);
      }
    }

    async function enviar(mensaje: string, reset = false) {
      estado!.textContent = 'Pensando…';
      // Se bloquea la entrada mientras el bot responde: sin esto, dos envíos seguidos pintan las
      // burbujas desordenadas porque la respuesta del primero llega después del segundo mensaje.
      entrada!.disabled = true;
      try {
        const elegido = candidatos.find((item) => item.providerId === candidato!.value);
        const respuesta = await fetch('/api/chat/test', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ sessionId, message: mensaje, reset, ...(reset && elegido ? { provider: elegido } : {}) }),
        });
        const datos = await respuesta.json();
        if (!datos.ok) {
          estado!.textContent = `Error: ${datos.error}`;
          return;
        }
        burbuja(datos.reply, 'bot');
        pintarBorrador(datos.draft ?? {});
        estado!.textContent = datos.finished
          ? (datos.submissionId ? `Ficha guardada · ${datos.submissionId.slice(0, 8)}` : 'Conversación cerrada')
          : `Listo · ${datos.outcome}`;
        if (datos.finished) entrada!.dataset.cerrado = 'true';
      } catch {
        estado!.textContent = 'No se pudo contactar al servidor';
      } finally {
        // Salvo que la conversación haya terminado, donde queda bloqueada a propósito.
        if (!entrada!.dataset.cerrado) entrada!.disabled = false;
        entrada!.focus();
      }
    }

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const texto = entrada.value.trim();
      if (!texto) return;
      burbuja(texto, 'persona');
      entrada.value = '';
      await enviar(texto);
    });

    async function empezar() {
      hilo!.innerHTML = '';
      delete entrada!.dataset.cerrado;
      await enviar('', true);
    }

    reiniciar?.addEventListener('click', empezar);
    // Cambiar de candidato reinicia: la conversación anterior era con otro negocio.
    candidato.addEventListener('change', empezar);

    // Saludo inicial y lista de candidatos importados.
    fetch('/api/chat/test')
      .then((respuesta) => respuesta.json())
      .then((datos) => {
        if (!datos.ok) return;
        candidatos = datos.candidates ?? [];
        for (const item of candidatos) {
          const opcion = document.createElement('option');
          opcion.value = item.providerId;
          opcion.textContent = `${item.displayName}${item.city ? ` · ${item.city}` : ''}${item.category ? ` · ${item.category}` : ''}`;
          candidato!.appendChild(opcion);
        }
        estado!.textContent = `Listo · ${candidatos.length} candidatos`;
        burbuja(datos.greeting, 'bot');
        pintarBorrador({});
      })
      .catch(() => { estado.textContent = 'No se pudo cargar el saludo'; });
  }
</script>
