---
import AppLayout from '../layouts/AppLayout.astro';
import { fetchCampaignOverview, fetchDashboard } from '../lib/api-client';
const data = await fetchDashboard(Astro.url.origin);
// `omnisendReady` lo decide el backend, que es quien tiene la llave: el front solo lo muestra.
const { omnisendReady } = await fetchCampaignOverview(Astro.url.origin);
---
<AppLayout active="" title="Configuración"><div class="page"><header class="page-header"><div><p class="eyebrow">Salud del sistema</p><h1>Configuración</h1><p class="page-intro">Puntos que deben quedar resueltos antes de habilitar campañas reales.</p></div></header><div class="content-grid"><section class="panel detail-panel"><div class="section-heading"><h2>Conexiones</h2></div><ul class="settings-list"><li><span><strong>PostgreSQL</strong><small>Base de datos de operación</small></span><b class="check-state">{data.connected ? 'Conectado' : 'Demo'}</b></li><li><span><strong>Omnisend</strong><small>Envío desde servidor, nunca navegador</small></span><b class={omnisendReady ? 'check-state' : 'pending-state'}>{omnisendReady ? 'Conectado' : 'Pendiente'}</b></li><li><span><strong>HTTPS</strong><small>Requerido para campañas y formularios</small></span><b class="pending-state">Pendiente</b></li></ul></section><section class="panel detail-panel"><div class="section-heading"><h2>Protecciones</h2></div><ul class="settings-list"><li><span><strong>Consentimiento</strong><small>Privacidad y marketing separados</small></span><b class="check-state">Activo</b></li><li><span><strong>Tracking</strong><small>Tokens opacos y hashes</small></span><b class="check-state">Activo</b></li><li><span><strong>Backups</strong><small>pg_dump programado a S3</small></span><b class="pending-state">Pendiente</b></li></ul></section><section class="panel detail-panel zona-riesgo"><div class="section-heading"><h2>Borrar los datos de operación</h2></div><p class="zona-texto">Elimina proveedores, contactos, campañas, envíos, clics y formularios recibidos. <strong>No se puede deshacer.</strong> El historial de auditoría se conserva, para que quede constancia de qué se borró y cuándo.</p><div class="zona-conteo" id="reset-conteo">Consultando cuántos registros hay…</div><div class="zona-acciones"><label class="zona-confirmar">Escribe <code>BORRAR TODO</code> para habilitar<input class="form-input" id="reset-input" type="text" autocomplete="off" placeholder="BORRAR TODO" /></label><button class="danger-button" id="reset-boton" type="button" disabled>Borrar todos los registros</button></div><p class="zona-estado" id="reset-estado" role="status"></p></section></div></div></AppLayout>
<style>.settings-list{display:grid;gap:0;margin:0;padding:0;list-style:none}.settings-list li{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 0;border-top:1px solid var(--line)}.settings-list li:first-child{border-top:0}.settings-list strong,.settings-list small{display:block}.settings-list strong{font-size:12px}.settings-list small{margin-top:4px;color:var(--text-subtle);font-size:11px}.settings-list b{padding:5px 9px;border-radius:7px;font-size:10px;white-space:nowrap}.check-state{color:var(--ok);background:var(--ok-bg)}.pending-state{color:var(--warn);background:var(--warn-bg)}</style>
<script>
  const CONFIRMACION = 'BORRAR TODO';
  const entrada = document.querySelector<HTMLInputElement>('#reset-input');
  const boton = document.querySelector<HTMLButtonElement>('#reset-boton');
  const conteo = document.querySelector<HTMLElement>('#reset-conteo');
  const estado = document.querySelector<HTMLElement>('#reset-estado');

  const ETIQUETAS: Record<string, string> = {
    providers: 'proveedores', contacts: 'contactos', campaigns: 'campañas',
    campaign_sends: 'envíos', campaign_personalizations: 'personalizaciones',
    email_clicks: 'clics', registration_submissions: 'formularios', provider_sources: 'fuentes',
  };

  function resumir(counts: Record<string, number>) {
    const partes = Object.entries(counts)
      .filter(([, n]) => n > 0)
      .map(([tabla, n]) => `${n} ${ETIQUETAS[tabla] ?? tabla}`);
    return partes.length ? partes.join(' · ') : 'No hay registros que borrar.';
  }

  async function cargarConteo() {
    if (!conteo) return;
    try {
      const body = await fetch('/api/providers/reset').then((response) => response.json());
      if (!body.ok) throw new Error(body.error ?? 'No se pudo consultar.');
      conteo.textContent = resumir(body.counts);
      if (boton && body.total === 0) boton.disabled = true;
    } catch (error) {
      conteo.textContent = error instanceof Error ? error.message : 'No se pudo consultar.';
    }
  }

  // El boton solo se habilita con la confirmacion escrita: un clic accidental no debe borrar nada.
  entrada?.addEventListener('input', () => {
    if (boton) boton.disabled = entrada.value.trim() !== CONFIRMACION;
  });

  boton?.addEventListener('click', async () => {
    if (entrada?.value.trim() !== CONFIRMACION) return;
    boton.disabled = true;
    if (estado) estado.textContent = 'Borrando…';
    try {
      const body = await fetch('/api/providers/reset', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ confirm: CONFIRMACION }),
      }).then((response) => response.json());
      if (!body.ok) throw new Error(body.error ?? 'No se pudo borrar.');
      if (estado) estado.textContent = `Borrados ${body.total} registros. ${resumir(body.deleted)}`;
      if (entrada) entrada.value = '';
      await cargarConteo();
    } catch (error) {
      if (estado) estado.textContent = error instanceof Error ? error.message : 'No se pudo borrar.';
      if (boton) boton.disabled = entrada?.value.trim() !== CONFIRMACION;
    }
  });

  cargarConteo();
</script>
<style>.zona-riesgo{border-color:var(--danger)!important}.zona-riesgo h2{color:var(--danger)}.zona-texto{margin:0 0 13px;color:var(--text-muted);font-size:12px;line-height:1.55;max-width:62ch}.zona-texto strong{color:var(--text)}.zona-conteo{padding:10px 13px;border:1px solid var(--line);border-radius:9px;background:var(--surface-2);color:var(--text-muted);font:11px var(--font-mono)}.zona-acciones{display:flex;flex-wrap:wrap;align-items:flex-end;gap:11px;margin-top:13px}.zona-confirmar{display:grid;gap:6px;flex:1 1 230px;color:var(--text);font-size:11px;font-weight:600}.zona-confirmar code{padding:1px 5px;border-radius:3px;background:var(--surface-2);color:var(--danger);font:11px var(--font-mono)}.danger-button{min-height:38px;padding:0 15px;border:1px solid var(--danger);border-radius:9px;background:var(--danger-bg);color:var(--danger);font-size:12px;font-weight:600;cursor:pointer}.danger-button:disabled{opacity:.42;cursor:not-allowed}.danger-button:not(:disabled):hover{background:var(--danger);color:var(--bg)}.zona-estado{min-height:17px;margin:11px 0 0;color:var(--text-muted);font-size:12px}@media(max-width:560px){.zona-acciones{flex-direction:column;align-items:stretch}.danger-button{width:100%}}</style>
