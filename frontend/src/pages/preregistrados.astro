---
import AppLayout from '../layouts/AppLayout.astro';
import { fetchPreregistered } from '../lib/api-client';

// Proveedores que ya confirmaron sus datos y esperan aprobación. La pregunta que se hace aquí el
// operador no es "quién es este proveedor" sino "¿lo que contó cuadra con la evidencia pública que
// ya teníamos?", así que cada ficha enseña las dos cosas juntas.
const proveedores = await fetchPreregistered(Astro.url.origin);
const canal = (fuente: string | null) => {
  if (fuente === 'whatsapp-bot') return 'WhatsApp';
  if (fuente === 'chat-prueba') return 'Chat de prueba';
  if (fuente === 'email-link') return 'Enlace de correo';
  return 'Sin registrar';
};
---
<AppLayout active="Preregistrados" title="Preregistrados">
  <div class="page">
    <header class="page-header">
      <div>
        <p class="eyebrow">Esperando aprobación</p>
        <h1>Proveedores preregistrados</h1>
        <p class="page-intro">Confirmaron sus datos por su cuenta. Nadie está aprobado todavía: aquí se compara lo que contaron con la evidencia pública que ya teníamos.</p>
      </div>
      <span class="count-chip">{proveedores.length} en cola</span>
    </header>

    {!proveedores.length && (
      <div class="empty-state">
        <strong>Todavía no hay proveedores preregistrados</strong>
        <p>Cuando un candidato complete su registro —por WhatsApp o por el enlace del correo— aparecerá aquí para revisión.</p>
      </div>
    )}

    <div class="prereg-grid">
      {proveedores.map((proveedor) => (
        <article class="panel prereg">
          <div class="prereg-head">
            <div>
              <a class="prereg-nombre" href={`/proveedores/${proveedor.provider_id}`}>{proveedor.display_name}</a>
              <div class="prereg-meta">
                {proveedor.city && <span class="meta-chip">{proveedor.city}</span>}
                {proveedor.category && <span class="meta-chip">{proveedor.category}</span>}
                <span class="meta-chip">Vía {canal(proveedor.consent_source)}</span>
              </div>
            </div>
            <div class="prereg-repu">
              {proveedor.rating !== null
                ? <><strong>{proveedor.rating} ★</strong><small>{proveedor.review_count ?? 0} reseñas</small></>
                : <small>Sin reputación</small>}
            </div>
          </div>

          <dl class="prereg-datos">
            <div><dt>Contacto</dt><dd>{proveedor.full_name ?? '—'}</dd></div>
            <div><dt>Correo</dt><dd>{proveedor.email ?? '—'}</dd></div>
            <div><dt>Teléfono</dt><dd>{proveedor.phone ?? '—'}</dd></div>
            <div><dt>Asistentes</dt><dd>{proveedor.volume_min !== null ? `de ${proveedor.volume_min} a ${proveedor.volume_max}` : '—'}</dd></div>
          </dl>

          {/* El nombre que dio puede no ser el que teníamos: es justo lo que hay que mirar. */}
          {proveedor.company_name && proveedor.company_name !== proveedor.display_name && (
            <p class="prereg-aviso"><strong>Se identificó como</strong> «{proveedor.company_name}», distinto al nombre con el que lo encontramos.</p>
          )}

          {proveedor.services.length > 0 && (
            <div class="prereg-listas">
              <span class="prereg-etiqueta">Categorías</span>
              <div class="prereg-tags">{proveedor.services.map((s) => <span class="meta-chip">{s}</span>)}</div>
            </div>
          )}

          {proveedor.products.length > 0 && (
            <div class="prereg-listas">
              <span class="prereg-etiqueta">Ofrece</span>
              <div class="prereg-tags">{proveedor.products.map((p) => <span class="meta-chip meta-chip-extra">{p}</span>)}</div>
            </div>
          )}

          {proveedor.description && <p class="prereg-nota">{proveedor.description}</p>}

          <footer class="prereg-pie">
            <span class={proveedor.marketing_consent ? 'consent-si' : 'consent-no'}>
              {proveedor.marketing_consent ? 'Aceptó comunicaciones comerciales' : 'Sin consentimiento comercial'}
            </span>
            <span class="muted">{proveedor.submitted_at ?? 'Sin fecha'}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</AppLayout>

<style>
  .count-chip { align-self: center; padding: 7px 13px; border: 1px solid var(--line); border-radius: 999px; color: var(--text-muted); background: var(--surface-2); font-size: 12px; font-weight: 600; }
  .prereg-grid { display: grid; gap: 14px; }
  .prereg { padding: 20px 22px; }
  .prereg-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .prereg-nombre { color: var(--text); font-size: 16px; font-weight: 650; text-decoration: none; }
  .prereg-nombre:hover { color: var(--accent); }
  .prereg-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .prereg-repu { display: grid; justify-items: end; gap: 2px; color: var(--text); font-size: 13px; white-space: nowrap; }
  .prereg-repu small { color: var(--text-subtle); font-size: 11px; }
  .prereg-datos { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 18px 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); }
  .prereg-datos div { display: grid; gap: 3px; }
  .prereg-datos dt { color: var(--text-subtle); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .prereg-datos dd { margin: 0; color: var(--text); font-size: 13px; overflow-wrap: anywhere; }
  .prereg-aviso { margin: 14px 0 0; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 9px; color: var(--text-muted); background: var(--surface-2); font-size: 12px; line-height: 1.5; }
  .prereg-listas { margin-top: 14px; }
  .prereg-etiqueta { display: block; margin-bottom: 7px; color: var(--text-subtle); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .prereg-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .prereg-nota { margin: 14px 0 0; color: var(--text-muted); font-size: 12px; line-height: 1.55; }
  .prereg-pie { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 11px; }
  .consent-si { color: var(--accent); font-weight: 600; }
  .consent-no { color: var(--text-subtle); }
</style>
