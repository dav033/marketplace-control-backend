---
import AppLayout from '../layouts/AppLayout.astro';
import MetricCard from '../components/MetricCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { fetchDashboard } from '../lib/api-client';

const data = await fetchDashboard(Astro.url.origin);
const activity = data.registrations.length
  ? data.registrations.map((item) => ({ title: item.company_name || item.full_name || 'Formulario recibido', text: `${item.email} envió sus datos para revisión.`, time: item.created_at, kind: 'inbox' }))
  : [
      { title: 'Lote listo para revisar', text: 'Importa los proveedores devueltos por el prompt v2.8.', time: 'Siguiente paso', kind: 'pin' },
      { title: 'Campaña pendiente', text: 'Los clics aparecerán aquí cuando exista un enlace rastreable.', time: 'Sin actividad aún', kind: 'send' },
    ];
---
<AppLayout active="Resumen" title="Resumen operativo">
  <div class="page">
    <header class="page-header">
      <div><p class="eyebrow">Control room / hoy</p><h1>Resumen operativo</h1><p class="page-intro">De proveedor encontrado a conversación iniciada. Revisa el pulso del lote y decide la próxima acción.</p></div>
      <a class="primary-button" href="/proveedores#importar"><svg viewBox="0 0 20 20"><path d="M10 3v10M6 9l4 4 4-4M4 17h12"/></svg>Importar proveedores</a>
    </header>

    {!data.connected && <div class="notice"><span class="notice-dot"></span><span><strong>Modo demostración.</strong> Configura <code>DATABASE_URL</code> para ver datos reales de PostgreSQL.</span></div>}

    <section class="metric-grid" aria-label="Indicadores principales">
      <MetricCard label="Por revisar" value={data.counts.candidates} note="candidatos en cola" kind="pin" />
      <MetricCard label="Contactados" value={data.counts.contacted} note="con envío registrado" kind="send" />
      <MetricCard label="Mostraron interés" value={data.counts.interested} note="hicieron clic" kind="spark" />
      <MetricCard label="Formularios" value={data.counts.submissions} note="esperando revisión" kind="inbox" />
    </section>

    <div class="content-grid">
      <section>
        <div class="section-heading"><h2>Cola de proveedores</h2><a class="text-link" href="/proveedores">Ver todos</a></div>
        <div class="panel table-wrap">
          <table class="data-table">
            <thead><tr><th>Proveedor</th><th>Ubicación</th><th>Evidencia</th><th>Estado</th><th>Actividad</th></tr></thead>
            <tbody>
              {data.providers.slice(0, 5).map((provider) => <tr>
                <td><a class="provider-link" href={`/proveedores/${provider.provider_id}`}>{provider.display_name}</a><div class="muted">{provider.category}</div></td>
                <td>{provider.city}</td>
                <td><span class="rating">{provider.rating ?? '—'} <span>★</span></span><div class="muted">{provider.review_count ?? '—'} reseñas</div></td>
                <td><StatusBadge status={provider.status} /></td>
                <td class="muted">{provider.last_activity ?? '—'}</td>
              </tr>)}
            </tbody>
          </table>
        </div>
      </section>
      <section>
        <div class="section-heading"><h2>Actividad reciente</h2><a class="text-link" href="/formularios">Bandeja</a></div>
        <div class="panel"><ul class="activity-list">
          {activity.map((item) => <li class="activity-item"><span class="activity-dot" aria-hidden="true"><svg viewBox="0 0 20 20">{item.kind === 'send' ? <><path d="m18 2-7 16-3-7-6-3 16-6Z"/><path d="m8 11 4-4"/></> : item.kind === 'pin' ? <><path d="M10 18s6-5.2 6-10A6 6 0 0 0 4 8c0 4.8 6 10 6 10Z"/><circle cx="10" cy="8" r="2"/></> : <><path d="M3 4h14v12H3z"/><path d="M3 12h4l1 2h4l1-2h4"/></>}</svg></span><span><strong>{item.title}</strong><p>{item.text}</p><small class="activity-time">{item.time}</small></span></li>)}
        </ul></div>
      </section>
    </div>
  </div>
</AppLayout>

<style>
  .notice { display: flex; align-items: center; gap: 9px; margin: -8px 0 21px; padding: 11px 14px; border: 1px solid var(--warn-line); border-radius: 10px; color: var(--warn); background: var(--warn-bg); font-size: 12px; }.notice-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--warn); }.notice code { padding: 2px 5px; border-radius: 5px; background: var(--surface-2); font-family: var(--font-mono); font-size: 11px; }
</style>
