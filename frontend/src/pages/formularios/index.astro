---
import AppLayout from '../../layouts/AppLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { fetchDashboard } from '../../lib/api-client';
const data = await fetchDashboard(Astro.url.origin);
---
<AppLayout active="Formularios" title="Formularios">
  <div class="page"><header class="page-header"><div><p class="eyebrow">Respuesta de proveedores</p><h1>Formularios recibidos</h1><p class="page-intro">Cada respuesta requiere revisión humana. Recibir datos no equivale a aprobación.</p></div></header><section class="panel table-panel"><div class="panel-head"><span><strong>Bandeja de entrada</strong> · {data.registrations.length} visibles</span><span>Más recientes primero</span></div>{data.registrations.length ? <div class="table-wrap"><table class="data-table"><thead><tr><th>Empresa / contacto</th><th>Correo</th><th>Estado</th><th>Recibido</th><th></th></tr></thead><tbody>{data.registrations.map((item) => <tr><td><strong>{item.company_name ?? 'Sin empresa'}</strong><div class="muted">{item.full_name ?? 'Nombre pendiente'}</div></td><td>{item.email}</td><td><StatusBadge status={item.submission_status} /></td><td class="muted">{item.created_at}</td><td><a class="text-link" href={`/formularios/${item.submission_id}`}>Revisar</a></td></tr>)}</tbody></table></div> : <div class="empty-state"><strong>Aún no hay formularios</strong><p>Cuando un proveedor complete un enlace, su respuesta aparecerá aquí para revisión.</p></div>}</section></div>
</AppLayout>
