DATABASE_URL=postgresql://marketplace_app:REDACTED@127.0.0.1:5432/marketplace
SESSION_SECRET=replace-with-32-random-characters
TRACKING_SECRET=replace-with-32-random-characters
ADMIN_ACCESS_KEY=
LOCAL_AUTO_LOGIN=false
APP_URL=http://localhost:4321
# Separación front/back. Vacío = mismo origen (front y back en el mismo proceso, como hasta ahora).
# En el frontend (Vercel) apunta al dominio del backend; en el backend se deja vacío.
BACKEND_URL=
# Dominio donde vive el panel. Lo usa el backend para mandar el clic del correo al formulario, que
# tras la separación ya no se sirve desde el backend. Vacío = mismo dominio que el backend.
FRONTEND_URL=
# Token compartido con el que el frontend se identifica ante /api/v1/*. Debe ser el mismo valor en
# los dos despliegues. Sin él, el backend en producción responde 503 en vez de abrirse.
BACKEND_SERVICE_TOKEN=
REGISTRATION_TOKEN_TTL_DAYS=30
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.8-flash
CURATION_PROVIDER=gemini
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=sonnet
CODEX_CLI_PATH=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
GOOGLE_PLACES_API_KEY=
# --- Bot de WhatsApp (Cloud API de Meta) ---
# Cadena que tú inventas y repites en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta. Con esto se valida la firma de cada webhook entrante.
WHATSAPP_APP_SECRET=
# Token de acceso y id del número (el de prueba sirve, sin verificación de negocio).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Nosotros escribimos primero, así que el primer mensaje SIEMPRE es una plantilla aprobada por Meta:
# fuera de la ventana de 24h un texto libre lo rechaza la API. Nombre de la plantilla aprobada, cuyo
# texto debe tener dos huecos en este orden: {{1}} nombre del negocio, {{2}} ciudad.
WHATSAPP_OUTREACH_TEMPLATE=
WHATSAPP_OUTREACH_LANGUAGE=es
# Contactos nuevos por dia. Meta asigna un cupo que sube o baja segun la calidad de la cuenta, y
# gastarlo de golpe el primer dia es la forma rapida de que lo recorten.
WHATSAPP_DAILY_OUTREACH_LIMIT=20
# El bot del chat redacta con el mismo CLI de Codex que usa la curaduría (CODEX_* arriba): no
# necesita API key propia. Si el CLI no está disponible, el bot sigue funcionando con sus mensajes
# fijos; solo pierde la capacidad de responder fuera de guion.
# Modelo propio del chat. Por el CLI no hay modelos sin razonamiento (la cuenta rechaza gpt-4o-mini
# y la API rechaza el esfuerzo 'minimal'), así que aquí va el más rápido disponible, no el más capaz.
CHAT_MODEL=gpt-5.6-luna
CHAT_REASONING_EFFORT=low
OMNISEND_API_KEY=
OMNISEND_VERSION=2026-03-15
OMNISEND_SENDER_NAME=Happia
OMNISEND_SENDER_EMAIL=info@happia.co
OMNISEND_REPLY_TO_EMAIL=
QA_TEST_RECIPIENT=david.theran03@gmail.com
QA_TEST_RECIPIENTS=davidt@sempertex.com,andresp@sempertex.com,david.theran03@sempertex.com
