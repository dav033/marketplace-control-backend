DATABASE_URL=postgresql://marketplace_app:REDACTED@127.0.0.1:5432/marketplace
SESSION_SECRET=replace-with-32-random-characters
TRACKING_SECRET=replace-with-32-random-characters
ADMIN_ACCESS_KEY=
LOCAL_AUTO_LOGIN=false
APP_URL=http://localhost:4321
# Separación front/back. Vacío = mismo origen (front y back en el mismo proceso, como hasta ahora).
# En el frontend (Vercel) apunta al dominio del backend; en el backend se deja vacío.
BACKEND_URL=
# Dominio donde vive el panel. Lo usa el backend para mandar el clic del correo al formulario, que
# tras la separación ya no se sirve desde el backend. Vacío = mismo dominio que el backend.
FRONTEND_URL=
# Token compartido con el que el frontend se identifica ante /api/v1/*. Debe ser el mismo valor en
# los dos despliegues. Sin él, el backend en producción responde 503 en vez de abrirse.
BACKEND_SERVICE_TOKEN=
REGISTRATION_TOKEN_TTL_DAYS=30
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.8-flash
CURATION_PROVIDER=gemini
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=sonnet
CODEX_CLI_PATH=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
# --- Google Places (apagado por defecto) ---
# Los campos que pide el código facturan como SKU "Text Search Enterprise": 1.000 peticiones gratis
# al mes y ~USD 35 por cada 1.000 más. La clave sola NO activa nada.
GOOGLE_PLACES_API_KEY=
# Opt-in explícito. Sin "1" no sale ninguna petición aunque haya clave.
GOOGLE_PLACES_OPT_IN=
# Interruptor de emergencia: con "1" apaga Places aunque haya opt-in.
GOOGLE_PLACES_KILL_SWITCH=
# Tope duro de peticiones por proceso y día UTC (vacío = 50). Un valor ilegible cierra la puerta.
GOOGLE_PLACES_MAX_REQUESTS=
# Reputación de las filas en "Sin dato": ficha de Google Maps vía Serper (/maps, 3 créditos por consulta).
# Sin clave, la buscan subagentes de Gemini (más lentos e intermitentes). CURATION_SKIP_REPUTATION_SUBAGENTS=1 apaga el paso.
SERPER_API_KEY=
# --- Bot de WhatsApp (Cloud API de Meta) ---
# Cadena que tú inventas y repites en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta. Con esto se valida la firma de cada webhook entrante.
WHATSAPP_APP_SECRET=
# Token de acceso y id del número (el de prueba sirve, sin verificación de negocio).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Nosotros escribimos primero, así que el primer mensaje SIEMPRE es una plantilla aprobada por Meta:
# fuera de la ventana de 24h un texto libre lo rechaza la API. Nombre de la plantilla aprobada, cuyo
# texto debe tener dos huecos en este orden: {{1}} nombre del negocio, {{2}} ciudad.
WHATSAPP_OUTREACH_TEMPLATE=
WHATSAPP_OUTREACH_LANGUAGE=es
# EL CUPO. Meta asigna un cupo que sube o baja segun la calidad de la cuenta, y gastarlo de golpe el
# primer dia es la forma rapida de que lo recorten. Tres topes, cada uno con su trabajo:
#   LIMIT  = el ritmo: lo que sale en 24 horas sin tocar el pool de la semana.
#   WEEKLY = el presupuesto real de los ultimos 7 dias. Por defecto, 7 x LIMIT.
#   BURST  = el techo de un dia cuando toma prestado del pool. Por defecto, 2 x LIMIT.
# Las dos ventanas son moviles (ultimas 24 h y ultimos 7 dias): el pool se recupera solo y no hay
# dia de reinicio en el que se pierda lo que no se uso.
WHATSAPP_DAILY_OUTREACH_LIMIT=30
WHATSAPP_WEEKLY_OUTREACH_LIMIT=210
WHATSAPP_DAILY_OUTREACH_BURST=60
# Desde cuando cuenta el cupo (ISO-8601). Subir el ritmo no borra lo ya enviado: las ventanas son
# moviles y lo anterior sigue restando. Con un instante aqui se empieza de cero sin tocar el
# historico. Se apaga solo a los 7 dias. Ilegible o en el futuro: se ignora.
WHATSAPP_QUOTA_EPOCH=
# El agente que conversa por WhatsApp usa la API de Gemini con GEMINI_API_KEY (arriba). Sin ella,
# responde que una persona del equipo contestará. Un modelo rápido basta: un turno son dos frases.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Simular un contacto desde el panel: al mandar "id: <proveedor>" al WhatsApp de Happia, el sistema
# responde como si le hubiera escrito primero a ese proveedor. Vacío = cualquier número puede.
# Una lista separada por comas lo restringe a esos números; "off" lo desactiva.
WHATSAPP_SIMULATION_NUMBERS=
# Modo prueba: con un número aquí, TODO WhatsApp que sale (invitaciones y respuestas del agente) va a
# ese número y no al proveedor real. Quitarlo antes de escribir a proveedores de verdad.
WHATSAPP_REDIRECT_ALL_TO=
OMNISEND_API_KEY=
OMNISEND_VERSION=2026-03-15
OMNISEND_SENDER_NAME=Happia
OMNISEND_SENDER_EMAIL=info@happia.co
OMNISEND_REPLY_TO_EMAIL=
QA_TEST_RECIPIENT=david.theran03@gmail.com
QA_TEST_RECIPIENTS=davidt@sempertex.com,andresp@sempertex.com,david.theran03@sempertex.com
